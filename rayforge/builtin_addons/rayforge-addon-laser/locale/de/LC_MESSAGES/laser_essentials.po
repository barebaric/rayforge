msgstr "Größe jedes Testquadrats"

#: laser_essentials/steps/material_test.py
msgid "Spacing"
msgstr "Abstand"

#: laser_essentials/steps/material_test.py
msgid "Gap between test squares"
msgstr "Abstand zwischen Testquadraten"

#: laser_essentials/steps/material_test.py
msgid "Line Interval"
msgstr "Linienabstand"

#: laser_essentials/steps/material_test.py
msgid ""
"Distance between scan lines in machine units (for Engrave mode). Leave at 0 "
"to use laser spot size"
msgstr ""
"Abstand zwischen Scanzeilen in Maschineneinheiten (für den Gravurmodus). Bei "
"0 wird die Laserspotgröße verwendet"

#: laser_essentials/steps/material_test.py
msgid "Include Labels"
msgstr "Beschriftungen einschließen"

#: laser_essentials/steps/material_test.py
msgid "Add speed/power annotations to the grid"
msgstr "Geschwindigkeits-/Leistungs-Anmerkungen zum Gitter hinzufügen"

#: laser_essentials/steps/material_test.py
msgid "Label Engrave Power (%)"
msgstr "Beschriftungs-Gravurleistung (%)"

#: laser_essentials/steps/material_test.py
msgid "Label Engrave Speed"
msgstr "Graviergeschwindigkeit für Beschriftung"

#: laser_essentials/steps/material_test.py
msgid "Speed for engraving labels"
msgstr "Geschwindigkeit für das Gravieren von Beschriftungen"

#: laser_essentials/steps/material_test.py
msgid "Fixed Speed"
msgstr "Feste Geschwindigkeit"

#: laser_essentials/steps/material_test.py
msgid "Constant speed for all cells"
msgstr "Konstante Geschwindigkeit für alle Zellen"

#: laser_essentials/steps/material_test.py
msgid "Fixed Power (%)"
msgstr "Feste Leistung (%)"

#: laser_essentials/steps/material_test.py
