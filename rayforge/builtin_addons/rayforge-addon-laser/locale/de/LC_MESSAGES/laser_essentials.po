#: laser_essentials/calibration/material_test_grid.py
msgid "Diode Engrave"
msgstr "Dioden-Gravur"

#: laser_essentials/calibration/material_test_grid.py
msgid "Diode Cut"
msgstr "Dioden-Schnitt"

#: laser_essentials/calibration/material_test_grid.py
msgid "CO2 Engrave"
msgstr "CO2-Gravur"

#: laser_essentials/calibration/material_test_grid.py
msgid "CO2 Cut"
msgstr "CO2-Schnitt"

#: laser_essentials/calibration/material_test_grid.py
#: laser_essentials/steps/material_test.py
msgid "Material Test Grid"
msgstr "Materialtestgitter"

#: laser_essentials/calibration/material_test_grid.py
msgid "Presets"
msgstr "Voreinstellungen"

#: laser_essentials/calibration/material_test_grid.py
msgid "Load common test configurations"
msgstr "Häufige Testkonfigurationen laden"

#: laser_essentials/calibration/material_test_grid.py
msgid "Select"
msgstr "Auswählen"

#: laser_essentials/calibration/material_test_grid.py
msgid ""
"The laser head and the post-processing of the grid stay in the settings of "
"its operation."
msgstr ""
"Der Laserkopf und die Nachbearbeitung des Rasters bleiben in den "
"Einstellungen der zugehörigen Operation."

#: laser_essentials/calibration/material_test_grid.py
msgid "A Material Test Grid needs at least 2×2 cells."
msgstr "Ein Materialtest-Raster benötigt mindestens 2×2 Zellen."

#: laser_essentials/calibration/focus_test.py
msgid "Z axis steps"
msgstr "Z-Achsen-Schritte"

#: laser_essentials/calibration/focus_test.py
msgid "Manual (pause between lines)"
msgstr "Manuell (Pause zwischen den Linien)"

#: laser_essentials/calibration/focus_test.py
msgid "Ramp (tilted material)"
msgstr "Rampe (geneigtes Material)"

#: laser_essentials/calibration/focus_test.py
msgid ""
"Focus the laser as usual first. The job moves the head to the first offset, "
"engraves one line per offset and returns the head to the starting height. A "
"positive offset means more distance between the head and the material."
msgstr ""
"Fokussiere den Laser zuerst wie gewohnt. Der Job fährt den Kopf auf den "
"ersten Versatz, graviert eine Linie pro Versatz und bringt den Kopf auf die "
"Ausgangshöhe zurück. Ein positiver Versatz bedeutet mehr Abstand zwischen "
"Kopf und Material."

#: laser_essentials/calibration/focus_test.py
msgid ""
"Focus the laser as usual first. The labels are engraved at that height. "
"Before each line the job pauses: set the head to the first offset, then move "
"it by one step at every following pause, and press Resume. A positive offset "
"means more distance between the head and the material."
msgstr ""
"Fokussiere den Laser zuerst wie gewohnt. Die Beschriftungen werden auf "
"dieser Höhe graviert. Vor jeder Linie pausiert der Job: Stelle den Kopf auf "
"den ersten Versatz, bewege ihn bei jeder weiteren Pause um einen Schritt und "
"drücke Fortsetzen. Ein positiver Versatz bedeutet mehr Abstand zwischen Kopf "
"und Material."

#: laser_essentials/calibration/focus_test.py
msgid ""
"Prop up one end of a flat strip so it rises evenly under the line. The "
"thinnest part of the line marks the focus; the ticks show the distance along "
"the line, so the height there follows from the rise."
msgstr ""
"Stütze ein Ende eines flachen Streifens unter, sodass er unter der Linie "
"gleichmäßig ansteigt. Die dünnste Stelle der Linie markiert den Fokus; die "
"Markierungen zeigen die Entfernung entlang der Linie, sodass sich die Höhe "
"dort aus dem Anstieg ergibt."

#: laser_essentials/calibration/focus_test.py
msgid "A Focus Test needs at least two lines."
msgstr "Ein Fokustest benötigt mindestens zwei Linien."

#: laser_essentials/calibration/focus_test.py
msgid "The focus step must not be zero."
msgstr "Die Fokus-Schrittweite darf nicht null sein."

#: laser_essentials/calibration/focus_test.py
#, python-brace-format
msgid ""
"The focus offsets must stay within ±{limit:g} mm of the starting height."
msgstr ""
"Die Fokus-Versätze müssen innerhalb von ±{limit:g} mm der Ausgangshöhe "
"bleiben."

#: laser_essentials/calibration/focus_test.py
#, python-brace-format
msgid "Z to {offset} mm"
msgstr "Z auf {offset} mm"

#: laser_essentials/calibration/focus_test.py
msgid "Z back to the starting height"
msgstr "Z zurück auf die Ausgangshöhe"

#: laser_essentials/calibration/focus_test.py
#, python-brace-format
msgid "Pause: set the head to {offset} mm from focus"
msgstr "Pause: Kopf auf {offset} mm vom Fokus stellen"

#: laser_essentials/calibration/focus_test.py
#, python-brace-format
msgid "Pause: move the head by {step} mm"
msgstr "Pause: Kopf um {step} mm bewegen"

#: laser_essentials/calibration/focus_test.py
msgid "Focus Test"
msgstr "Fokustest"

#: laser_essentials/calibration/focus_test.py
#, python-brace-format
msgid ""
"The method {method} is not available on this machine. Choose another method "
"to rebuild the test."
msgstr ""
"Die Methode {method} ist auf dieser Maschine nicht verfügbar. Wähle eine "
"andere Methode, um den Test neu zu erstellen."

#: laser_essentials/calibration/focus_test.py
msgid "Method"
msgstr "Methode"

#: laser_essentials/calibration/focus_test.py
msgid "First Offset"
msgstr "Erster Versatz"

#: laser_essentials/calibration/focus_test.py
msgid "Step"
msgstr "Schritt"

#: laser_essentials/calibration/focus_test.py
msgid "Number of Lines"
msgstr "Anzahl Linien"

#: laser_essentials/calibration/focus_test.py
msgid "Line Length"
msgstr "Linienlänge"

#: laser_essentials/calibration/focus_test.py
#: laser_essentials/calibration/interval_test.py
#: laser_essentials/steps/material_test.py
msgid "Spacing"
msgstr "Abstand"

#: laser_essentials/calibration/focus_test.py
msgid "Ramp Length"
msgstr "Rampenlänge"

#: laser_essentials/calibration/focus_test.py
#, python-brace-format
msgid "This machine does not support the focus test mode {mode}."
msgstr "Diese Maschine unterstützt den Fokustestmodus {mode} nicht."

#: laser_essentials/calibration/focus_test.py
#, python-brace-format
msgid "Focus {offset} mm"
msgstr "Fokus {offset} mm"

#: laser_essentials/calibration/focus_test.py
msgid "Focus ramp"
msgstr "Fokusrampe"

#: laser_essentials/calibration/common.py
#: laser_essentials/widgets/raster_page.py laser_essentials/steps/laser_step.py
msgid "Power"
msgstr "Leistung"

#: laser_essentials/calibration/common.py
msgid "Speed"
msgstr "Geschwindigkeit"

#: laser_essentials/calibration/common.py
#: laser_essentials/steps/material_test.py
msgid "Include Labels"
msgstr "Beschriftungen einschließen"

#: laser_essentials/calibration/common.py
msgid "Label Engrave Power (%)"
msgstr "Gravurleistung der Beschriftung (%)"

#: laser_essentials/calibration/common.py
#: laser_essentials/steps/material_test.py
msgid "Label Engrave Speed"
msgstr "Graviergeschwindigkeit für Beschriftung"

#: laser_essentials/calibration/common.py
msgid "Labels"
msgstr "Beschriftungen"

#: laser_essentials/calibration/builder.py
msgid "Machine commands need the Automation addon."
msgstr "Maschinenbefehle benötigen das Automation-Addon."

#: laser_essentials/calibration/interval_test.py
msgid "An Interval Test needs at least two cells."
msgstr "Ein Intervalltest benötigt mindestens zwei Zellen."

#: laser_essentials/calibration/interval_test.py
msgid "The minimum line interval must be above zero and below the maximum."
msgstr ""
"Das kleinste Linienintervall muss größer als null und kleiner als das größte "
"sein."

#: laser_essentials/calibration/interval_test.py
msgid "Interval Test"
msgstr "Intervalltest"

#: laser_essentials/calibration/interval_test.py
msgid "Number of Cells"
msgstr "Anzahl Zellen"

#: laser_essentials/calibration/interval_test.py
msgid "Smallest Interval"
msgstr "Kleinstes Intervall"

#: laser_essentials/calibration/interval_test.py
msgid "Largest Interval"
msgstr "Größtes Intervall"

#: laser_essentials/calibration/interval_test.py
msgid "Cell Size"
msgstr "Zellengröße"

#: laser_essentials/calibration/interval_test.py
msgid ""
"Engraves a row of filled squares, each with its own line interval, at the "
"same power and speed."
msgstr ""
"Graviert eine Reihe gefüllter Quadrate, jeweils mit eigenem Linienintervall, "
"bei gleicher Leistung und Geschwindigkeit."

#: laser_essentials/calibration/interval_test.py
#, python-brace-format
msgid "Interval {interval:.2f} mm"
msgstr "Intervall {interval:.2f} mm"

#: laser_essentials/calibration/interval_test.py
#, python-brace-format
msgid "{lpi:.0f} LPI"
msgstr "{lpi:.0f} LPI"

