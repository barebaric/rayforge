#: laser_essentials/calibration/material_test_grid.py
msgid "Diode Engrave"
msgstr "डायोड उत्कीर्णन"

#: laser_essentials/calibration/material_test_grid.py
msgid "Diode Cut"
msgstr "डायोड कट"

#: laser_essentials/calibration/material_test_grid.py
msgid "CO2 Engrave"
msgstr "CO2 उत्कीर्णन"

#: laser_essentials/calibration/material_test_grid.py
msgid "CO2 Cut"
msgstr "CO2 कट"

#: laser_essentials/calibration/material_test_grid.py
#: laser_essentials/steps/material_test.py
msgid "Material Test Grid"
msgstr "सामग्री परीक्षण ग्रिड"

#: laser_essentials/calibration/material_test_grid.py
msgid "Presets"
msgstr "प्रीसेट"

#: laser_essentials/calibration/material_test_grid.py
msgid "Load common test configurations"
msgstr "सामान्य परीक्षण कॉन्फ़िगरेशन लोड करें"

#: laser_essentials/calibration/material_test_grid.py
msgid "Select"
msgstr "चुनें"

#: laser_essentials/calibration/material_test_grid.py
msgid ""
"The laser head and the post-processing of the grid stay in the settings of "
"its operation."
msgstr "लेज़र हेड और ग्रिड की पोस्ट-प्रोसेसिंग उसके ऑपरेशन की सेटिंग्स में रहती हैं."

#: laser_essentials/calibration/material_test_grid.py
msgid "A Material Test Grid needs at least 2×2 cells."
msgstr "मटीरियल टेस्ट ग्रिड के लिए कम से कम 2×2 सेल चाहिए."

#: laser_essentials/calibration/focus_test.py
msgid "Z axis steps"
msgstr "Z अक्ष चरण"

#: laser_essentials/calibration/focus_test.py
msgid "Manual (pause between lines)"
msgstr "मैनुअल (लाइनों के बीच विराम)"

#: laser_essentials/calibration/focus_test.py
msgid "Ramp (tilted material)"
msgstr "रैंप (झुकी सामग्री)"

#: laser_essentials/calibration/focus_test.py
msgid ""
"Focus the laser as usual first. The job moves the head to the first offset, "
"engraves one line per offset and returns the head to the starting height. A "
"positive offset means more distance between the head and the material."
msgstr ""
"पहले लेज़र को सामान्य रूप से फोकस करें. जॉब हेड को पहले ऑफ़सेट पर ले जाता है, प्रत्येक ऑफ़सेट के "
"लिए एक लाइन उत्कीर्ण करता है और हेड को प्रारंभिक ऊँचाई पर वापस लाता है. धनात्मक ऑफ़सेट "
"का अर्थ है हेड और सामग्री के बीच अधिक दूरी."

#: laser_essentials/calibration/focus_test.py
msgid ""
"Focus the laser as usual first. The labels are engraved at that height. "
"Before each line the job pauses: set the head to the first offset, then move "
"it by one step at every following pause, and press Resume. A positive offset "
"means more distance between the head and the material."
msgstr ""
"पहले लेज़र को सामान्य रूप से फोकस करें. लेबल उस ऊँचाई पर उत्कीर्ण होते हैं. हर लाइन से पहले "
"जॉब रुकता है: हेड को पहले ऑफ़सेट पर सेट करें, हर अगले विराम पर उसे एक कदम आगे बढ़ाएँ और "
"रिज़्यूम दबाएँ. धनात्मक ऑफ़सेट का अर्थ है हेड और सामग्री के बीच अधिक दूरी."

#: laser_essentials/calibration/focus_test.py
msgid ""
"Prop up one end of a flat strip so it rises evenly under the line. The "
"thinnest part of the line marks the focus; the ticks show the distance along "
"the line, so the height there follows from the rise."
msgstr ""
"एक सपाट पट्टी के एक सिरे को सहारा दें ताकि वह लाइन के नीचे समान रूप से उठे. लाइन का "
"सबसे पतला भाग फोकस को दर्शाता है; निशान लाइन के साथ दूरी दिखाते हैं, इसलिए वहाँ की "
"ऊँचाई उठान से निकलती है."

#: laser_essentials/calibration/focus_test.py
msgid "A Focus Test needs at least two lines."
msgstr "फोकस टेस्ट के लिए कम से कम दो लाइनें चाहिए."

#: laser_essentials/calibration/focus_test.py
msgid "The focus step must not be zero."
msgstr "फोकस चरण शून्य नहीं होना चाहिए."

#: laser_essentials/calibration/focus_test.py
#, python-brace-format
msgid ""
"The focus offsets must stay within ±{limit:g} mm of the starting height."
msgstr "फोकस ऑफ़सेट प्रारंभिक ऊँचाई के ±{limit:g} मिमी के भीतर रहने चाहिए."

#: laser_essentials/calibration/focus_test.py
#, python-brace-format
msgid "Z to {offset} mm"
msgstr "Z {offset} मिमी पर"

#: laser_essentials/calibration/focus_test.py
msgid "Z back to the starting height"
msgstr "Z प्रारंभिक ऊँचाई पर वापस"

#: laser_essentials/calibration/focus_test.py
#, python-brace-format
msgid "Pause: set the head to {offset} mm from focus"
msgstr "विराम: हेड को फोकस से {offset} मिमी पर सेट करें"

#: laser_essentials/calibration/focus_test.py
#, python-brace-format
msgid "Pause: move the head by {step} mm"
msgstr "विराम: हेड को {step} मिमी आगे बढ़ाएँ"

#: laser_essentials/calibration/focus_test.py
msgid "Focus Test"
msgstr "फोकस टेस्ट"

#: laser_essentials/calibration/focus_test.py
#, python-brace-format
msgid ""
"The method {method} is not available on this machine. Choose another method "
"to rebuild the test."
msgstr "विधि {method} इस मशीन पर उपलब्ध नहीं है. टेस्ट बनाने के लिए दूसरी विधि चुनें."

#: laser_essentials/calibration/focus_test.py
msgid "Method"
msgstr "विधि"

#: laser_essentials/calibration/focus_test.py
msgid "First Offset"
msgstr "पहला ऑफ़सेट"

#: laser_essentials/calibration/focus_test.py
msgid "Step"
msgstr "चरण"

#: laser_essentials/calibration/focus_test.py
msgid "Number of Lines"
msgstr "लाइनों की संख्या"

#: laser_essentials/calibration/focus_test.py
msgid "Line Length"
msgstr "लाइन की लंबाई"

#: laser_essentials/calibration/focus_test.py
#: laser_essentials/calibration/interval_test.py
#: laser_essentials/steps/material_test.py
msgid "Spacing"
msgstr "स्पेसिंग"

#: laser_essentials/calibration/focus_test.py
msgid "Ramp Length"
msgstr "रैंप की लंबाई"

#: laser_essentials/calibration/focus_test.py
#, python-brace-format
msgid "This machine does not support the focus test mode {mode}."
msgstr "यह मशीन फोकस टेस्ट मोड {mode} का समर्थन नहीं करती."

#: laser_essentials/calibration/focus_test.py
#, python-brace-format
msgid "Focus {offset} mm"
msgstr "फोकस {offset} मिमी"

#: laser_essentials/calibration/focus_test.py
msgid "Focus ramp"
msgstr "फोकस रैंप"

