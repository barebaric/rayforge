msgid "Number of power variations"
msgstr "शक्ति भिन्नताओं की संख्या"

#: laser_essentials/widgets/material_test_grid_page.py
#: laser_essentials/steps/material_test.py
msgid "Number of speed variations"
msgstr "गति भिन्नताओं की संख्या"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Rows (Passes Steps)"
msgstr "पंक्तियाँ (पास चरण)"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Number of passes variations"
msgstr "पास भिन्नताओं की संख्या"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Columns (Speed Steps)"
msgstr "कॉलम (गति चरण)"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Rows (Offset Steps)"
msgstr "पंक्तियाँ (ऑफ़सेट चरण)"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Number of offset variations"
msgstr "ऑफ़सेट भिन्नताओं की संख्या"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Grid"
msgstr "ग्रिड"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Test cell dimensions, shape, and spacing."
msgstr "परीक्षण सेल विमाएँ, आकार, और स्पेसिंग."

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Labels"
msgstr "लेबल"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Speed/power annotations on the grid."
msgstr "ग्रिड पर गति/शक्ति एनोटेशन."

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Parameters"
msgstr "पैरामीटर"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Define the parameter ranges for the test grid."
msgstr "परीक्षण ग्रिड के लिए पैरामीटर सीमाएँ परिभाषित करें."

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Diode Engrave"
msgstr "डायोड उत्कीर्णन"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Diode Cut"
msgstr "डायोड कट"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "CO2 Engrave"
msgstr "CO2 उत्कीर्णन"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "CO2 Cut"
msgstr "CO2 कट"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Select"
msgstr "चुनें"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Preset"
msgstr "प्रीसेट"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Load common test configurations."
msgstr "सामान्य परीक्षण कॉन्फ़िगरेशन लोड करें."

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Presets"
msgstr "प्रीसेट"

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Load common test configurations"
msgstr "सामान्य परीक्षण कॉन्फ़िगरेशन लोड करें"

#: laser_essentials/widgets/raster_power_widget.py
#: laser_essentials/steps/raster_step.py
msgid "Power for lightest areas, as a percentage of the step's main power"
msgstr "सबसे उजले क्षेत्रों के लिए शक्ति, स्टेप की मुख्य शक्ति के प्रतिशत के रूप में"

#: laser_essentials/widgets/raster_power_widget.py
#: laser_essentials/steps/raster_step.py
msgid "Power for darkest areas, as a percentage of the step's main power"
msgstr "सबसे गहरे क्षेत्रों के लिए शक्ति, स्टेप की मुख्य शक्ति के प्रतिशत के रूप में"

#: laser_essentials/widgets/raster_power_widget.py
msgid "Min Power (Black)"
msgstr "न्यूनतम शक्ति (काला)"

#: laser_essentials/widgets/raster_power_widget.py
msgid "Max Power (White)"
msgstr "अधिकतम शक्ति (सफ़ेद)"

#: laser_essentials/widgets/raster_power_widget.py
msgid "Min Power (White)"
msgstr "न्यूनतम शक्ति (सफ़ेद)"

#: laser_essentials/widgets/raster_power_widget.py
msgid "Max Power (Black)"
msgstr "अधिकतम शक्ति (काला)"

#: laser_essentials/widgets/raster_page.py
msgid "Engrave Speed"
msgstr "उत्कीर्णन गति"

#: laser_essentials/widgets/raster_page.py
msgid "Raster the image onto the material."
msgstr "छवि को सामग्री पर रास्टर करें."

#: laser_essentials/widgets/raster_page.py laser_essentials/steps/laser_step.py
msgid "Power"
msgstr "शक्ति"

#: laser_essentials/widgets/raster_page.py
msgid "Power modulation and brightness range."
msgstr "शक्ति मॉडुलन और चमक सीमा."

#: laser_essentials/widgets/raster_page.py
msgid "Change Power Range"
msgstr "शक्ति सीमा बदलें"

#: laser_essentials/widgets/levels_adapter.py
msgid "Auto-adjusted based on image content"
msgstr "छवि सामग्री के आधार पर स्वतः समायोजित"

#: laser_essentials/widgets/levels_adapter.py
msgid "Drag markers to set black/white points"
msgstr "काले/सफ़ेद बिंदु सेट करने के लिए मार्कर खींचें"

#: laser_essentials/steps/laser_step.py
msgid ""
"Laser head used for this step; the machine's first head is used when unset"
msgstr ""
"इस स्टेप के लिए उपयोग होने वाला लेज़र हेड; असेट न होने पर मशीन का पहला हेड उपयोग होता है"

#: laser_essentials/steps/laser_step.py
msgid "Laser power as a percentage"
msgstr "प्रतिशत के रूप में लेज़र शक्ति"

#: laser_essentials/steps/laser_step.py
msgid "Power Mode"
msgstr "शक्ति मोड"

#: laser_essentials/steps/laser_step.py
msgid ""
"Dynamic power (M4) scales power with head speed; constant power (M3) keeps "
"it fixed. Use constant power if corners and curves burn too lightly"
msgstr ""
"डायनामिक पावर (M4) हेड गति के साथ शक्ति स्केल करता है; स्थिर शक्ति (M3) उसे नियत रखती "
"है. यदि कोने और वक्र बहुत हल्के जलते हैं तो स्थिर शक्ति उपयोग करें"

#: laser_essentials/steps/laser_step.py
msgid "Dynamic (M4)"
msgstr "डायनामिक (M4)"

#: laser_essentials/steps/laser_step.py
msgid "Constant (M3)"
msgstr "स्थिर (M3)"

#: laser_essentials/steps/laser_step.py
msgid "Air Assist"
msgstr "एयर असिस्ट"

#: laser_essentials/steps/laser_step.py
msgid "Blow air over the cut to clear debris"
msgstr "मलबा साफ़ करने के लिए कट पर हवा फूँकें"

#: laser_essentials/steps/laser_step.py
msgid "Tab Power"
msgstr "टैब शक्ति"

#: laser_essentials/steps/laser_step.py
msgid "Laser power at tab positions as a percentage"
msgstr "टैब स्थितियों पर लेज़र शक्ति प्रतिशत के रूप में"

#: laser_essentials/steps/laser_step.py
msgid "Frequency"
msgstr "आवृत्ति"

#: laser_essentials/steps/laser_step.py
msgid "Laser pulse frequency in Hz (0 = head default)"
msgstr "Hz में लेज़र पल्स आवृत्ति (0 = हेड डिफ़ॉल्ट)"

#: laser_essentials/steps/laser_step.py
msgid "Pulse Width"
msgstr "पल्स चौड़ाई"

#: laser_essentials/steps/laser_step.py
msgid "Laser pulse width in ns (0 = head default)"
msgstr "ns में लेज़र पल्स चौड़ाई (0 = हेड डिफ़ॉल्ट)"

#: laser_essentials/steps/laser_step.py
msgid "Step Settings"
msgstr "स्टेप सेटिंग्स"

#: laser_essentials/steps/laser_step.py
#, python-brace-format
msgid "{power_percent}% power, {speed_str}"
msgstr "{power_percent}% शक्ति, {speed_str}"

#: laser_essentials/steps/shrinkwrap_step.py
msgid "Gravity"
msgstr "ग्रैविटी"

#: laser_essentials/steps/shrinkwrap_step.py
msgid "Pulls the hull inward. 0.0 is a standard convex hull"
msgstr "हल को भीतर की ओर खींचता है. 0.0 एक मानक उत्तल हल है"

#: laser_essentials/steps/shrinkwrap_step.py
#: laser_essentials/steps/frame_step.py laser_essentials/steps/contour_step.py
msgid "Cut Side"
msgstr "कट पक्ष"

#: laser_essentials/steps/shrinkwrap_step.py
#: laser_essentials/steps/wavefront_step.py
#: laser_essentials/steps/frame_step.py laser_essentials/steps/contour_step.py
msgid "Offset"
msgstr "ऑफ़सेट"

#: laser_essentials/steps/shrinkwrap_step.py
msgid ""
"Shifts the contour inward/outward per Cut Side (none on Centerline). "
"Defaults to kerf compensation for the head"
msgstr ""
"कट पक्ष के अनुसार कॉन्टूर को भीतर/बाहर खिसकाता है (केंद्र रेखा पर कोई नहीं). हेड के लिए "
"कर्फ़ क्षतिपूर्ति डिफ़ॉल्ट है"

#: laser_essentials/steps/wavefront_step.py
msgid "Step Over"
msgstr "स्टेप ओवर"

#: laser_essentials/steps/wavefront_step.py
msgid "Lateral step-over between wavefront passes"
msgstr "वेवफ़्रंट पास के बीच पार्श्व स्टेप-ओवर"

#: laser_essentials/steps/wavefront_step.py
msgid "Extra offset from walls"
msgstr "दीवारों से अतिरिक्त ऑफ़सेट"

#: laser_essentials/steps/frame_step.py
msgid "Frame"
msgstr "फ़्रेम"

#: laser_essentials/steps/frame_step.py
msgid ""
"Shifts the frame inward/outward per Cut Side (none on Centerline). Defaults "
"to kerf compensation for the head"
msgstr ""
"कट पक्ष के अनुसार फ़्रेम को भीतर/बाहर खिसकाता है (केंद्र रेखा पर कोई नहीं). हेड के लिए कर्फ़ "
"क्षतिपूर्ति डिफ़ॉल्ट है"

#: laser_essentials/steps/frame_step.py
msgid "Round Corners"
msgstr "कोने गोल करें"

#: laser_essentials/steps/frame_step.py
msgid "Round the frame's corners instead of cutting right angles"
msgstr "समकोण काटने के बजाय फ़्रेम के कोने गोल करें"

#: laser_essentials/steps/frame_step.py
msgid "Corner Radius"
msgstr "कोना त्रिज्या"

#: laser_essentials/steps/frame_step.py
msgid "Radius used to round the frame's corners"
msgstr "फ़्रेम के कोने गोल करने के लिए त्रिज्या"

#: laser_essentials/steps/raster_step.py
msgid "Mode"
msgstr "मोड"

#: laser_essentials/steps/raster_step.py laser_essentials/steps/contour_step.py
msgid "Threshold"
msgstr "थ्रेशोल्ड"

#: laser_essentials/steps/raster_step.py
msgid "Brightness cutoff for black/white (0-255)"
msgstr "काले/सफ़ेद के लिए चमक कटऑफ़ (0-255)"

#: laser_essentials/steps/raster_step.py
msgid "Engraving Method"
msgstr "उत्कीर्णन विधि"

#: laser_essentials/steps/raster_step.py
msgid "Algorithm for converting grayscale to binary"
msgstr "ग्रेस्केल को बाइनरी में बदलने का एल्गोरिदम"

#: laser_essentials/steps/raster_step.py
msgid "Cross-Hatch"
msgstr "क्रॉस-हैच"

#: laser_essentials/steps/raster_step.py
msgid "Add a second pass at 90 degrees"
msgstr "90 डिग्री पर दूसरा पास जोड़ें"

#: laser_essentials/steps/raster_step.py
msgid "Scan Mode"
msgstr "स्कैन मोड"

#: laser_essentials/steps/raster_step.py
msgid "Segmented"
msgstr "खंडित"

#: laser_essentials/steps/raster_step.py
msgid "Full Sweep"
msgstr "पूर्ण स्वीप"

#: laser_essentials/steps/raster_step.py
msgid ""
"Segmented: moves between content regions. Full Sweep: scans full width with "
"laser toggling"
msgstr ""
"खंडित: सामग्री क्षेत्रों के बीच गति करता है. पूर्ण स्वीप: लेज़र टॉगलिंग के साथ पूरी चौड़ाई "
"स्कैन करता है"

#: laser_essentials/steps/raster_step.py
msgid "Line Spacing"
msgstr "रेखा अंतराल"

#: laser_essentials/steps/raster_step.py
msgid "Distance between scan lines"
msgstr "स्कैन रेखाओं के बीच दूरी"

#: laser_essentials/steps/raster_step.py
msgid "Sample Interval"
msgstr "सैंपल अंतराल"

#: laser_essentials/steps/raster_step.py
msgid ""
"Distance between power samples along scan line. Lower values improve "
"accuracy, but increase output size"
msgstr ""
"स्कैन रेखा पर शक्ति सैंपलों के बीच दूरी. कम मान सटीकता सुधारते हैं, लेकिन आउटपुट आकार बढ़ाते हैं"

#: laser_essentials/steps/raster_step.py
msgid "Dot Width Correction"
msgstr "डॉट चौड़ाई सुधार"

#: laser_essentials/steps/raster_step.py
msgid ""
"Reduces engrave length at both ends to compensate for physical dot width"
msgstr "भौतिक डॉट चौड़ाई की क्षतिपूर्ति के लिए दोनों सिरों पर उत्कीर्णन लंबाई घटाता है"

#: laser_essentials/steps/raster_step.py
msgid "Bidirectional Scan Offset"
msgstr "द्विदिशात्मक स्कैन ऑफ़सेट"

#: laser_essentials/steps/raster_step.py
msgid ""
"Corrects X misalignment between left-to-right and right-to-left raster passes"
msgstr "बाएँ-से-दाएँ और दाएँ-से-बाएँ रास्टर पास के बीच X बेमेल ठीक करता है"

#: laser_essentials/steps/raster_step.py
msgid "Invert"
msgstr "उलटें"

#: laser_essentials/steps/raster_step.py
msgid "Engrave white areas instead of black areas"
msgstr "काले क्षेत्रों के बजाय सफ़ेद क्षेत्र उत्कीर्ण करें"

#: laser_essentials/steps/raster_step.py
msgid "Number of Depth Levels"
msgstr "गहराई स्तरों की संख्या"

#: laser_essentials/steps/raster_step.py
msgid "Z Step-Down per Level"
msgstr "प्रति स्तर Z स्टेप-डाउन"

#: laser_essentials/steps/raster_step.py
msgid "Rotate Angle Per Pass"
msgstr "प्रति पास घूर्णन कोण"

#: laser_essentials/steps/raster_step.py
msgid "Degrees to rotate each successive pass"
msgstr "प्रत्येक अगले पास को घुमाने के डिग्री"

#: laser_essentials/steps/raster_step.py
msgid "Auto Levels"
msgstr "स्वतः स्तर"

#: laser_essentials/steps/raster_step.py
msgid "Automatically adjust black/white points"
msgstr "काले/सफ़ेद बिंदु स्वतः समायोजित करें"

#: laser_essentials/steps/raster_step.py
msgid "White Point"
msgstr "सफ़ेद बिंदु"

#: laser_essentials/steps/raster_step.py
msgid "Min Power"
msgstr "न्यूनतम शक्ति"

#: laser_essentials/steps/raster_step.py
msgid "Max Power"
msgstr "अधिकतम शक्ति"

#: laser_essentials/steps/raster_step.py
msgid "Power Levels"
msgstr "शक्ति स्तर"

#: laser_essentials/steps/raster_step.py
msgid "Number of discrete power steps (lower = fewer moves)"
msgstr "असतत शक्ति चरणों की संख्या (कम = कम गतियाँ)"

#: laser_essentials/steps/raster_step.py
#, python-brace-format
msgid "The {mode} depth mode is not supported by this machine's driver."
msgstr "{mode} गहराई मोड इस मशीन के ड्राइवर द्वारा समर्थित नहीं है."

#: laser_essentials/steps/contour_step.py
msgid "Contour"
msgstr "कॉन्टूर"

#: laser_essentials/steps/contour_step.py
msgid ""
"Shifts the cut path inward/outward per Cut Side (none on Centerline). "
"Defaults to kerf compensation for the head"
msgstr ""
"कट पक्ष के अनुसार कट पाथ को भीतर/बाहर खिसकाता है (केंद्र रेखा पर कोई नहीं). हेड के लिए "
"कर्फ़ क्षतिपूर्ति डिफ़ॉल्ट है"

#: laser_essentials/steps/contour_step.py
msgid "Cut Order"
msgstr "कट क्रम"

#: laser_essentials/steps/contour_step.py
msgid "Processing order for nested paths"
