msgid "Change Head"
msgstr "Alterar Cabeça"

#: laser_essentials/widgets/rows/offset_row.py
msgid ""
"Shifts the path inward/outward per Cut Side (none on Centerline). Defaults "
"to kerf compensation for the head"
msgstr ""
"Desloca o percurso para dentro/fora conforme o Lado de Corte (nenhum na "
"Linha Central). Por predefinição, compensação de kerf para a cabeça"

