msgid ""
"Shifts the frame inward/outward per Cut Side (none on Centerline). Defaults "
"to kerf compensation for the head"
msgstr ""
"Décale le cadre vers l'intérieur/extérieur selon le côté de coupe (aucun sur "
"la ligne centrale). Par défaut, compense le kerf de la tête"

#: laser_essentials/steps/raster_step.py
msgid "Mode"
msgstr "Mode"

