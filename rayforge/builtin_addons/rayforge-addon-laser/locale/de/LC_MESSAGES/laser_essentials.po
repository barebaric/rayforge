msgstr "Schneide einen Rahmen um den ausgewählten Inhalt."

#: laser_essentials/widgets/calibration_provider.py
msgid "Test Settings"
msgstr "Testeinstellungen"

#: laser_essentials/widgets/calibration_provider.py
msgid ""
"Changing a setting rebuilds the test. The other settings of its operation "
"stay."
msgstr ""
"Eine Änderung einer Einstellung erstellt den Test neu. Die übrigen "
"Einstellungen der Operation bleiben erhalten."

#: laser_essentials/widgets/calibration_provider.py
msgid ""
"Changing a setting rebuilds the test and replaces changes made to its "
"operations."
msgstr ""
"Eine Änderung einer Einstellung erstellt den Test neu und ersetzt Änderungen "
"an seinen Operationen."

#: laser_essentials/widgets/raster_power_widget.py
msgid "Min Power (White)"
msgstr "Minimale Leistung (Weiß)"

#: laser_essentials/widgets/raster_power_widget.py
#: laser_essentials/steps/raster_step.py
msgid "Power for lightest areas, as a percentage of the step's main power"
msgstr ""
"Leistung für die hellsten Bereiche, als Prozent der Hauptleistung des "
"Schritts"

#: laser_essentials/widgets/raster_power_widget.py
msgid "Max Power (Black)"
msgstr "Maximale Leistung (Schwarz)"

#: laser_essentials/widgets/raster_power_widget.py
#: laser_essentials/steps/raster_step.py
msgid "Power for darkest areas, as a percentage of the step's main power"
msgstr ""
"Leistung für die dunkelsten Bereiche, als Prozent der Hauptleistung des "
"Schritts"

#: laser_essentials/widgets/raster_page.py
msgid "Engrave Speed"
msgstr "Graviergeschwindigkeit"

#: laser_essentials/widgets/raster_page.py
msgid "Raster the image onto the material."
msgstr "Rastere das Bild auf das Material."

#: laser_essentials/widgets/raster_page.py
msgid "Power modulation and brightness range."
msgstr "Leistungsmodulation und Helligkeitsbereich."

#: laser_essentials/widgets/raster_page.py
msgid "Change Power Range"
msgstr "Leistungsbereich ändern"

#: laser_essentials/widgets/offset_fill_page.py
#: laser_essentials/steps/offset_fill_step.py
msgid "Offset Fill"
msgstr "Versatz-Füllung"

#: laser_essentials/widgets/offset_fill_page.py
msgid "Fill closed shapes with rings that follow the outline."
msgstr "Füllt geschlossene Formen mit Ringen, die der Kontur folgen."

#: laser_essentials/widgets/levels_adapter.py
msgid "Auto-adjusted based on image content"
msgstr "Automatisch angepasst basierend auf Bildinhalt"

#: laser_essentials/widgets/levels_adapter.py
msgid "Drag markers to set black/white points"
msgstr "Ziehe die Markierungen, um Schwarz-/Weißpunkte festzulegen"

#: laser_essentials/steps/laser_step.py
msgid ""
"Laser head used for this step; the machine's first head is used when unset"
msgstr ""
"Für diesen Schritt verwendeter Laserkopf; falls nicht gesetzt, wird der "
"erste Kopf der Maschine verwendet"

#: laser_essentials/steps/laser_step.py
msgid "Laser power as a percentage"
msgstr "Laserleistung als Prozentsatz"

#: laser_essentials/steps/laser_step.py
msgid "Power Mode"
msgstr "Leistungsmodus"

#: laser_essentials/steps/laser_step.py
msgid ""
"Dynamic power (M4) scales power with head speed; constant power (M3) keeps "
"it fixed. Use constant power if corners and curves burn too lightly"
msgstr ""
"Dynamische Leistung (M4) skaliert die Leistung mit der Kopfgeschwindigkeit; "
"konstante Leistung (M3) hält sie unverändert. Verwenden Sie konstante "
"Leistung, wenn Ecken und Kurven zu schwach brennen"

#: laser_essentials/steps/laser_step.py
msgid "Dynamic (M4)"
msgstr "Dynamisch (M4)"

#: laser_essentials/steps/laser_step.py
msgid "Constant (M3)"
msgstr "Konstant (M3)"

#: laser_essentials/steps/laser_step.py
msgid "Air Assist"
msgstr "Luftunterstützung"

#: laser_essentials/steps/laser_step.py
msgid "Blow air over the cut to clear debris"
msgstr "Bläst Luft über den Schnitt, um Rückstände zu entfernen"

#: laser_essentials/steps/laser_step.py
msgid "Tab Power"
msgstr "Haltesteg-Leistung"

#: laser_essentials/steps/laser_step.py
msgid "Laser power at tab positions as a percentage"
msgstr "Laserleistung an den Haltesteg-Positionen als Prozentsatz"

#: laser_essentials/steps/laser_step.py
msgid "Frequency"
msgstr "Frequenz"

#: laser_essentials/steps/laser_step.py
msgid "Laser pulse frequency in Hz (0 = head default)"
msgstr "Laserpulsfrequenz in Hz (0 = Kopfstandardwert)"

#: laser_essentials/steps/laser_step.py
msgid "Pulse Width"
msgstr "Pulsbreite"

#: laser_essentials/steps/laser_step.py
msgid "Laser pulse width in ns (0 = head default)"
msgstr "Laserpulsbreite in ns (0 = Kopfstandardwert)"

#: laser_essentials/steps/laser_step.py
msgid "Step Settings"
msgstr "Schritt-Einstellungen"

#: laser_essentials/steps/laser_step.py
#, python-brace-format
msgid "{power_percent}% power, {speed_str}"
msgstr "{power_percent}% Leistung, {speed_str}"

#: laser_essentials/steps/shrinkwrap_step.py
msgid "Gravity"
msgstr "Anziehung"

#: laser_essentials/steps/shrinkwrap_step.py
msgid "Pulls the hull inward. 0.0 is a standard convex hull"
msgstr "Zieht die Hülle nach innen. 0.0 ist eine standardmäßige konvexe Hülle"

#: laser_essentials/steps/shrinkwrap_step.py
#: laser_essentials/steps/frame_step.py laser_essentials/steps/contour_step.py
msgid "Cut Side"
msgstr "Schnittseite"

#: laser_essentials/steps/shrinkwrap_step.py
#: laser_essentials/steps/wavefront_step.py
#: laser_essentials/steps/frame_step.py
#: laser_essentials/steps/offset_fill_step.py
msgid "Offset"
msgstr "Versatz"

#: laser_essentials/steps/shrinkwrap_step.py
msgid ""
"Shifts the contour inward/outward per Cut Side (none on Centerline). "
"Defaults to kerf compensation for the head"
msgstr ""
"Verschiebt die Kontur je nach Schnittseite nach innen/außen (keine bei "
"Mittellinie). Standardmäßig Kerf-Kompensation für den Kopf"

#: laser_essentials/steps/wavefront_step.py
msgid "Step Over"
msgstr "Schrittweite"

#: laser_essentials/steps/wavefront_step.py
msgid "Lateral step-over between wavefront passes"
msgstr "Seitliche Zustellung zwischen den Wellenfrontdurchgängen"

#: laser_essentials/steps/wavefront_step.py
msgid "Extra offset from walls"
msgstr "Zusätzlicher Versatz von Wänden"

#: laser_essentials/steps/frame_step.py
msgid "Frame"
msgstr "Rahmen"

#: laser_essentials/steps/frame_step.py
msgid ""
"Shifts the frame inward/outward per Cut Side (none on Centerline). Defaults "
"to kerf compensation for the head"
msgstr ""
"Verschiebt den Rahmen je nach Schnittseite nach innen/außen (keine bei "
"Mittellinie). Standardmäßig Kerf-Kompensation für den Kopf"

#: laser_essentials/steps/frame_step.py
msgid "Round Corners"
msgstr "Abgerundete Ecken"

#: laser_essentials/steps/frame_step.py
msgid "Round the frame's corners instead of cutting right angles"
msgstr ""
"Rundet die Ecken des Rahmens ab, statt rechtwinklige Ecken zu schneiden"

#: laser_essentials/steps/frame_step.py
msgid "Corner Radius"
msgstr "Eckenradius"

#: laser_essentials/steps/frame_step.py
msgid "Radius used to round the frame's corners"
msgstr "Radius zum Abrunden der Rahmenecken"

#: laser_essentials/steps/offset_fill_step.py
#: laser_essentials/steps/material_test.py
msgid "Line Interval"
msgstr "Linienabstand"

#: laser_essentials/steps/offset_fill_step.py
msgid ""
"Distance between neighbouring fill rings. Defaults to the laser spot size"
msgstr ""
"Abstand zwischen benachbarten Füllringen. Standardmäßig wird die "
"Laserspotgröße verwendet"

#: laser_essentials/steps/offset_fill_step.py
msgid "Distance of the first ring inside the outline"
msgstr "Abstand des ersten Rings innerhalb der Kontur"

#: laser_essentials/steps/offset_fill_step.py
msgid "Fill Direction"
msgstr "Füllrichtung"

#: laser_essentials/steps/offset_fill_step.py
msgid "Order in which the rings are cut"
msgstr "Reihenfolge, in der die Ringe geschnitten werden"

#: laser_essentials/steps/raster_step.py
msgid "Mode"
msgstr "Modus"

#: laser_essentials/steps/raster_step.py laser_essentials/steps/contour_step.py
msgid "Threshold"
msgstr "Schwellenwert"

#: laser_essentials/steps/raster_step.py
msgid "Brightness cutoff for black/white (0-255)"
msgstr "Helligkeitsgrenzwert für Schwarz/Weiß (0-255)"

#: laser_essentials/steps/raster_step.py
msgid "Engraving Method"
msgstr "Gravurmethode"

#: laser_essentials/steps/raster_step.py
msgid "Algorithm for converting grayscale to binary"
msgstr "Algorithmus zum Konvertieren von Graustufen in Binär"

#: laser_essentials/steps/raster_step.py
msgid "Serpentine"
msgstr "Serpentinenmodus"

#: laser_essentials/steps/raster_step.py
msgid ""
"Alternate the dither direction on every row to avoid directional artifacts"
msgstr ""
"Ditherrichtung in jeder Zeile wechseln, um richtungsabhängige Artefakte zu "
"vermeiden"

#: laser_essentials/steps/raster_step.py
msgid "Min Feature Size"
msgstr "Minimale Merkgröße"

#: laser_essentials/steps/raster_step.py
msgid ""
"Smallest dot width in scan-line pixels. The auto value matches the laser "
"spot size; smaller values allow finer but fainter dots"
msgstr ""
"Kleinste Punktbreite in Scanzeilen-Pixeln. Der Auto-Wert entspricht der "
"Laserpunktgröße; kleinere Werte erlauben feinere, aber schwächere Punkte"

#: laser_essentials/steps/raster_step.py
msgid "Linear Light"
msgstr "Lineares Licht"

#: laser_essentials/steps/raster_step.py
msgid ""
"Diffuse in linear light instead of on the raw sRGB values, which engraves "
"mid-tones darker"
msgstr ""
"Diffundiert im linearen Licht statt auf den rohen sRGB-Werten, wodurch "
"Mitteltöne dunkler graviert werden"

#: laser_essentials/steps/raster_step.py
msgid "Halftone Cell Size"
msgstr "Halbton-Zellgröße"

#: laser_essentials/steps/raster_step.py
msgid "Distance between halftone dot centers"
msgstr "Abstand zwischen den Mittelpunkten der Halbtonpunkte"

#: laser_essentials/steps/raster_step.py
msgid "Halftone Angle"
msgstr "Halbton-Winkel"

#: laser_essentials/steps/raster_step.py
msgid "Rotation of the halftone dot grid"
msgstr "Drehung des Halbton-Punktrasters"

#: laser_essentials/steps/raster_step.py
msgid "Cross-Hatch"
msgstr "Kreuzschraffur"

#: laser_essentials/steps/raster_step.py
msgid "Add a second pass at 90 degrees"
msgstr "Einen zweiten Durchgang bei 90 Grad hinzufügen"

#: laser_essentials/steps/raster_step.py
msgid "Scan Mode"
msgstr "Scan-Modus"

#: laser_essentials/steps/raster_step.py
msgid "Segmented"
msgstr "Segmentiert"

#: laser_essentials/steps/raster_step.py
msgid "Full Sweep"
msgstr "Vollflächig"

#: laser_essentials/steps/raster_step.py
msgid ""
"Segmented: moves between content regions. Full Sweep: scans full width with "
