#: ai_workpiece_generator/widgets/dialog.py
msgid "Generate a Workpiece"
msgstr "एक वर्कपीस जनरेट करें"

#: ai_workpiece_generator/widgets/dialog.py
msgid "Cancel"
msgstr "रद्द करें"

#: ai_workpiece_generator/widgets/dialog.py
msgid "Generate"
msgstr "जनरेट करें"

#: ai_workpiece_generator/widgets/dialog.py
msgid ""
"Describe the design you want to create. Example: 'A simple star shape with 5 "
"points'"
msgstr "बनाना चाहता डिज़ाइन बताएँ. उदाहरण: '5 बिंदुओं वाला एक साधारण तारा आकार'"

#: ai_workpiece_generator/widgets/dialog.py
msgid "No content generated."
msgstr "कोई सामग्री जनरेट नहीं हुई."

#: ai_workpiece_generator/widgets/dialog.py
msgid "Add AI-Generated Workpiece"
msgstr "AI-जनरेटेड वर्कपीस जोड़ें"

#: ai_workpiece_generator/widgets/dialog.py
msgid "Close"
msgstr "बंद करें"

#: ai_workpiece_generator/frontend.py
msgid "Generate Workpiece with AI..."
msgstr "AI से वर्कपीस जनरेट करें..."

#: ai_workpiece_generator/generator.py
msgid "No AI provider configured. Please configure an AI provider in Settings."
msgstr "कोई AI प्रदाता कॉन्फ़िगर नहीं है. कृपया सेटिंग्स में एक AI प्रदाता कॉन्फ़िगर करें."

#: ai_workpiece_generator/generator.py
msgid "No response from AI provider."
msgstr "AI प्रदाता से कोई प्रतिक्रिया नहीं."

#: ai_workpiece_generator/generator.py
msgid "AI did not generate valid SVG code. Please try a different prompt."
msgstr "AI ने वैध SVG कोड जनरेट नहीं किया. कृपया कोई भिन्न प्रॉम्प्ट आज़माएँ."
