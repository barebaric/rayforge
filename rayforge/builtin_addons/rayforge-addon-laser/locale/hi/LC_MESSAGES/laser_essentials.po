msgstr "वेवफ़्रंट टूलपाथ से पॉकेट साफ़ करें."

#: laser_essentials/widgets/laser_step_page.py
msgid "Cut Speed"
msgstr "कट गति"

#: laser_essentials/widgets/laser_step_page.py
#: laser_essentials/steps/laser_step.py
msgid "Laser power, speed, and head selection for this operation."
msgstr "इस ऑपरेशन के लिए लेज़र शक्ति, गति, और हेड चयन."

#: laser_essentials/widgets/laser_step_page.py
msgid "Settings provided by the machine's hardware for this head."
msgstr "इस हेड के लिए मशीन के हार्डवेयर द्वारा दी गई सेटिंग्स."

#: laser_essentials/widgets/laser_step_page.py
#: laser_essentials/steps/laser_step.py
msgid "Laser"
msgstr "लेज़र"

#: laser_essentials/widgets/laser_step_page.py
