msgid "One command per line. Path variables are expanded at encode time."
msgstr "Ein Befehl pro Zeile. Pfadvariablen werden beim Encodieren expandiert."

#: automation/steps/command_step.py
msgid "Command"
msgstr "Befehl"

#: automation/steps/command_step.py
msgid "Machine Code"
msgstr "Maschinencode"

#: automation/steps/command_step.py
msgid "No machine code"
msgstr "Kein Maschinencode"

#: automation/steps/command_step.py
#, python-brace-format
msgid "{count} lines"
msgstr "{count} Zeilen"

#: automation/steps/command_step.py
msgid "The command step has no machine code."
msgstr "Der Befehlsschritt enthält keinen Maschinencode."

#: automation/steps/command_step.py
#, python-brace-format
msgid ""
"The '{name}' driver does not support custom machine code; the lines are not "
"emitted for this machine."
msgstr ""
"Der Treiber „{name}“ unterstützt keinen benutzerdefinierten Maschinencode; "
"die Zeilen werden für diese Maschine nicht ausgegeben."

#: automation/steps/command_step.py
msgid "None"
msgstr "Keiner"
