#: laser_essentials/steps/laser_step.py
msgid ""
"Laser head used for this step; the machine's first head is used when unset"
msgstr ""
"Tête laser utilisée pour cette étape ; la première tête de la machine est "
"utilisée si non définie"

#: laser_essentials/steps/laser_step.py
msgid "Laser power as a percentage"
msgstr "Puissance laser en pourcentage"

#: laser_essentials/steps/laser_step.py
msgid "Power Mode"
msgstr "Mode de puissance"

#: laser_essentials/steps/laser_step.py
msgid ""
"Dynamic power (M4) scales power with head speed; constant power (M3) keeps "
"it fixed. Use constant power if corners and curves burn too lightly"
msgstr ""
"La puissance dynamique (M4) ajuste la puissance à la vitesse de la tête ; la "
"puissance constante (M3) la maintient fixe. Utilisez la puissance constante "
"si les angles et les courbes brûlent trop faiblement"

#: laser_essentials/steps/laser_step.py
msgid "Dynamic (M4)"
msgstr "Dynamique (M4)"

#: laser_essentials/steps/laser_step.py
msgid "Constant (M3)"
msgstr "Constante (M3)"

