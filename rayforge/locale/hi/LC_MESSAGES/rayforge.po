msgid ""
"This command can only be used when the machine is idle. Wait for the current "
"job to finish."
msgstr ""
"यह कमांड केवल तब उपयोग की जा सकती है जब मशीन निष्क्रिय हो. वर्तमान जॉब के समाप्त होने "
"की प्रतीक्षा करें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Commands Locked"
msgstr "कमांड लॉक"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Cannot send commands while in alarm or jog mode. Clear the alarm state first."
msgstr "अलार्म या जॉग मोड में कमांड नहीं भेज सकते. पहले अलार्म स्थिति साफ़ करें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Required"
msgstr "होमिंग आवश्यक"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Soft limits cannot be enabled without homing also enabled. Enable homing "
"first ($22=1)."
msgstr ""
"होमिंग सक्षम किए बिना सॉफ़्ट लिमिट सक्षम नहीं की जा सकतीं. पहले होमिंग सक्षम करें "
"($22=1)."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Line Too Long"
msgstr "पंक्ति बहुत लंबी"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The command line has too many characters and was ignored. Check your file "
"formatting."
msgstr ""
"कमांड पंक्ति में बहुत अधिक वर्ण हैं और इसे अनदेखा कर दिया गया. अपनी फ़ाइल फ़ॉर्मेटिंग जाँचें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Setting Too High"
msgstr "सेटिंग बहुत अधिक"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"This setting exceeds the maximum step rate supported. Use a lower value."
msgstr "यह सेटिंग समर्थित अधिकतम स्टेप दर से अधिक है. कम मान का उपयोग करें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Door Open"
msgstr "दरवाज़ा खुला"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The safety door was detected as open. Close the door and resume operation."
msgstr "सुरक्षा दरवाज़ा खुला पाया गया. दरवाज़ा बंद करें और संचालन जारी रखें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Build info or startup line exceeds storage limit. Shorten the line."
msgstr "बिल्ड जानकारी या स्टार्टअप पंक्ति भंडारण सीमा से अधिक है. पंक्ति छोटी करें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Target Out of Range"
msgstr "लक्ष्य सीमा से बाहर"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Jog target is beyond the machine's travel limits. Move to a position within "
"range."
msgstr "जॉग लक्ष्य मशीन की चालन सीमाओं से बाहर है. सीमा के भीतर किसी स्थिति में जाएँ."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Invalid Jog Command"
msgstr "अमान्य जॉग कमांड"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Jog command is missing '=' or contains prohibited G-code. Check the jog "
"syntax."
msgstr "जॉग कमांड में '=' अनुपस्थित है या इसमें निषिद्ध G-code है. जॉग सिंटैक्स जाँचें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Laser Mode Error"
msgstr "लेज़र मोड त्रुटि"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Laser mode requires PWM output to work. Check your hardware configuration."
msgstr "लेज़र मोड के काम करने के लिए PWM आउटपुट आवश्यक है. अपना हार्डवेयर कॉन्फ़िगरेशन जाँचें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Spindle Not Running"
msgstr "स्पिंडल नहीं चल रहा"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"A motion command was issued but the spindle is not running. Start the "
"spindle before motion."
msgstr ""
"एक मोशन कमांड जारी की गई लेकिन स्पिंडल नहीं चल रहा है. गति से पहले स्पिंडल शुरू करें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Spindle Speed Mismatch"
msgstr "स्पिंडल गति बेमेल"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The current spindle speed does not match the speed required by the command. "
"Wait for the spindle to reach the target speed."
msgstr ""
"वर्तमान स्पिंडल गति कमांड द्वारा आवश्यक गति से मेल नहीं खाती. स्पिंडल के लक्ष्य गति तक "
"पहुँचने की प्रतीक्षा करें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unsupported Command"
msgstr "असमर्थित कमांड"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"This G-code command is not supported by the machine. Check your post-"
"processor settings."
msgstr "यह G-code कमांड मशीन द्वारा समर्थित नहीं है. अपनी पोस्ट-प्रोसेसर सेटिंग्स जाँचें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Conflicting Commands"
msgstr "परस्पर विरोधी कमांड"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Multiple commands from the same group found on one line. Remove the "
"duplicate command."
msgstr "एक पंक्ति पर एक ही समूह की अनेक कमांड मिलीं. डुप्लिकेट कमांड हटाएँ."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Feed Rate Missing"
msgstr "फ़ीड दर अनुपस्थित"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Set a feed rate before using motion commands. Add an F command to specify "
"speed."
msgstr ""
"मोशन कमांड का उपयोग करने से पहले फ़ीड दर सेट करें. गति निर्दिष्ट करने के लिए F कमांड जोड़ें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Integer Required"
msgstr "पूर्णांक आवश्यक"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "This command requires a whole number value. Remove any decimal points."
msgstr "इस कमांड को एक पूर्ण संख्या मान की आवश्यकता है. कोई भी दशमलव बिंदु हटाएँ."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Axis Conflict"
msgstr "अक्ष संघर्ष"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Multiple commands trying to use the same axis. Simplify the command."
msgstr ""
"एकाधिक कमांड एक ही अक्ष का उपयोग करने का प्रयास कर रही हैं. कमांड को सरल बनाएँ."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Duplicate Word"
msgstr "डुप्लिकेट शब्द"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "The same G-code word appears more than once. Remove the duplicate."
msgstr "वही G-code शब्द एक से अधिक बार आता है. डुप्लिकेट हटाएँ."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Axis"
msgstr "अक्ष अनुपस्थित"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"This command requires XYZ axis coordinates. Add the missing axis values."
msgstr "इस कमांड को XYZ अक्ष निर्देशांकों की आवश्यकता है. अनुपस्थित अक्ष मान जोड़ें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Line Number Out of Range"
msgstr "पंक्ति संख्या सीमा से बाहर"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Line number must be between 1 and 9,999,999. Use a valid line number."
msgstr ""
"पंक्ति संख्या 1 और 9,999,999 के बीच होनी चाहिए. एक वैध पंक्ति संख्या का उपयोग करें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Value"
msgstr "मान अनुपस्थित"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "This command requires a P or L value. Add the missing parameter."
msgstr "इस कमांड को एक P या L मान की आवश्यकता है. अनुपस्थित पैरामीटर जोड़ें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unsupported Coordinate"
msgstr "असमर्थित निर्देशांक"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Only G54-G59 coordinate systems are supported. Use one of these instead."
msgstr ""
"केवल G54-G59 निर्देशांक प्रणालियाँ समर्थित हैं. इसके बजाय इनमें से किसी एक का उपयोग करें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Wrong Motion Mode"
msgstr "गलत मोशन मोड"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"G53 command requires G0 or G1 motion mode. Set the correct motion mode first."
msgstr "G53 कमांड को G0 या G1 मोशन मोड की आवश्यकता है. पहले सही मोशन मोड सेट करें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unused Axis Words"
msgstr "अप्रयुक्त अक्ष शब्द"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Axis words present but G80 cancel is active. Remove the unused axis words."
msgstr "अक्ष शब्द मौजूद हैं लेकिन G80 रद्द सक्रिय है. अप्रयुक्त अक्ष शब्द हटाएँ."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Arc Data"
msgstr "चाप डेटा अनुपस्थित"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"G2/G3 arc command needs XYZ coordinates. Add the axis values for the "
"selected plane."
msgstr ""
"G2/G3 चाप कमांड को XYZ निर्देशांकों की आवश्यकता है. चयनित समतल के लिए अक्ष मान जोड़ें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Invalid Target"
msgstr "अमान्य लक्ष्य"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Cannot create this arc or probe to current position. Check the target "
"coordinates."
msgstr "यह चाप या वर्तमान स्थिति पर प्रोब नहीं बना सकते. लक्ष्य निर्देशांक जाँचें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Arc Geometry Error"
msgstr "चाप ज्यामिति त्रुटि"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Arc calculation failed. Try breaking the arc into smaller pieces or use IJK "
"offset instead."
msgstr ""
"चाप गणना विफल रही. चाप को छोटे भागों में तोड़ने का प्रयास करें या इसके बजाय IJK ऑफ़सेट "
"का उपयोग करें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Arc Offset"
msgstr "चाप ऑफ़सेट अनुपस्थित"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"G2/G3 arc command needs IJK offset values. Add the missing offset for the "
"selected plane."
msgstr ""
"G2/G3 चाप कमांड को IJK ऑफ़सेट मानों की आवश्यकता है. चयनित समतल के लिए अनुपस्थित ऑफ़सेट "
"जोड़ें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unused Words"
msgstr "अप्रयुक्त शब्द"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Some G-code words in this line are not used by any command. Remove the "
"unused words."
msgstr ""
"इस पंक्ति में कुछ G-code शब्द किसी कमांड द्वारा उपयोग नहीं किए जाते. अप्रयुक्त शब्द हटाएँ."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Wrong Axis for Offset"
msgstr "ऑफ़सेट के लिए गलत अक्ष"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Tool length offset only works on the configured axis (usually Z-axis). Check "
"your settings."
msgstr ""
"टूल लंबाई ऑफ़सेट केवल कॉन्फ़िगर अक्ष पर काम करता है (प्रायः Z-अक्ष). अपनी सेटिंग्स जाँचें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Tool Number Too High"
msgstr "टूल नंबर बहुत अधिक"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Tool number exceeds the maximum supported value. Use a valid tool number."
msgstr "टूल नंबर अधिकतम समर्थित मान से अधिक है. एक वैध टूल नंबर का उपयोग करें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Hard Limit"
msgstr "हार्ड लिमिट"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"A hard limit switch was triggered. The machine has stopped and needs to be "
"reset. Check for obstructions and verify your limit switches."
msgstr ""
"एक हार्ड लिमिट स्विच सक्रिय हुआ. मशीन रुक गई है और उसे रीसेट करने की आवश्यकता है. बाधाओं "
"की जाँच करें और अपने लिमिट स्विच सत्यापित करें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Soft Limit"
msgstr "सॉफ़्ट लिमिट"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The machine would move beyond its configured travel limits. Check that your "
"work area and coordinate offsets are correct."
msgstr ""
"मशीन अपनी कॉन्फ़िगर चालन सीमाओं से बाहर जाएगी. जाँचें कि आपका कार्य क्षेत्र और निर्देशांक "
"ऑफ़सेट सही हैं."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Abort Cycle"
msgstr "साइकिल निरस्त करें"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The currently running job was cancelled while in motion. Reset the machine "
"to continue."
msgstr ""
"वर्तमान में चल रहा जॉब गति के दौरान रद्द कर दिया गया. जारी रखने के लिए मशीन रीसेट करें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Probe Fail — Initial"
msgstr "प्रोब विफल — प्रारंभिक"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The probe did not make contact before the maximum travel distance was "
"reached. Check the probe wiring and positioning."
msgstr ""
"अधिकतम चालन दूरी प्राप्त होने से पहले प्रोब ने संपर्क नहीं किया. प्रोब वायरिंग और स्थिति "
"जाँचें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Probe Fail — Final"
msgstr "प्रोब विफल — अंतिम"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The probe failed to retract to the target position after contact. Check the "
"probe configuration."
msgstr "संपर्क के बाद प्रोब लक्ष्य स्थिति पर वापस आने में विफल रहा. प्रोब कॉन्फ़िगरेशन जाँचें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Fail — Reset"
msgstr "होमिंग विफल — रीसेट"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Homing was not able to complete because the machine is in an alarm state. "
"Clear the alarm and try again."
msgstr ""
"मशीन अलार्म स्थिति में होने के कारण होमिंग पूर्ण नहीं हो सकी. अलार्म साफ़ करें और फिर से "
"प्रयास करें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Fail — Approach"
msgstr "होमिंग विफल — अप्रोच"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The homing cycle failed to find the switch within the configured travel "
"distance. Check your switch wiring and pull-off settings."
msgstr ""
"होमिंग चक्र कॉन्फ़िगर चालन दूरी के भीतर स्विच नहीं ढूँढ़ पाया. अपनी स्विच वायरिंग और pull-"
"off सेटिंग्स जाँचें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Fail — Pulloff"
msgstr "होमिंग विफल — पुल-ऑफ़"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The homing cycle failed to successfully pull off the switch after contact. "
"Increase the pull-off distance or check the switch."
msgstr ""
"संपर्क के बाद होमिंग चक्र स्विच से सफलतापूर्वक पुल-ऑफ़ नहीं कर पाया. पुल-ऑफ़ दूरी बढ़ाएँ या "
"स्विच जाँचें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Home Without Limits"
msgstr "लिमिट के बिना होम"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Homing was commanded but limit switches are not configured. Enable limit "
"switches first."
msgstr ""
"होमिंग की कमांड दी गई लेकिन लिमिट स्विच कॉन्फ़िगर नहीं हैं. पहले लिमिट स्विच सक्षम करें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Fail — Dual Axis"
msgstr "होमिंग विफल — द्वैध अक्ष"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Homing failed on a dual-axis configuration. One or both axes did not reach "
"their limit switches. Check your limit switch wiring and configuration."
msgstr ""
"द्वैध-अक्ष कॉन्फ़िगरेशन पर होमिंग विफल रही. एक या दोनों अक्ष अपने लिमिट स्विच तक नहीं "
"पहुँचे. अपनी लिमिट स्विच वायरिंग और कॉन्फ़िगरेशन जाँचें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unknown Alarm"
msgstr "अज्ञात अलार्म"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Invalid alarm code reported by machine."
msgstr "मशीन द्वारा रिपोर्ट किया गया अमान्य अलार्म कोड."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The machine reported an unrecognized alarm code. Check your machine and "
"firmware documentation."
msgstr ""
"मशीन ने एक अपहस्ताक्षरित अलार्म कोड रिपोर्ट किया. अपने मशीन और फ़र्मवेयर दस्तावेज़ीकरण "
"की जाँच करें."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unknown Error"
msgstr "अज्ञात त्रुटि"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Invalid error code reported by machine."
msgstr "मशीन द्वारा रिपोर्ट किया गया अमान्य त्रुटि कोड."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The machine reported an unrecognized error code. Check your machine and "
"firmware documentation."
msgstr ""
