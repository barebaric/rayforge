msgid "Hostname"
msgstr "Имя хоста"

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid "The IP address or hostname of the Ruida controller"
msgstr "IP-адрес или имя хоста контроллера Ruida"

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid "USB device path or VID:PID (e.g. 0403:6001)"
msgstr "Путь к USB-устройству или VID:PID (например, 0403:6001)"

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid "Magic"
msgstr "Магическое число"

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid ""
"Controller magic number in hex. The default 0x88 works for most controllers."
msgstr ""
"Магическое число контроллера в шестнадцатеричном виде. Значение по умолчанию "
"0x88 подходит для большинства контроллеров."

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid "TUI RPC"
msgstr "TUI RPC"

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid ""
"Enable RPC connection to a remote RPA TUI service.Useful for problem "
"diagnosis and experimentation."
msgstr ""
"Включить RPC-подключение к удалённой службе RPA TUI. Полезно для диагностики "
"проблем и экспериментов."

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid "RPC timeout (s)"
msgstr "Тайм-аут RPC (с)"

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid ""
"Maximum seconds to wait for each synchronous RPC. Raise for large jobs with "
"many layers."
msgstr ""
"Максимальное время ожидания каждого синхронного RPC в секундах. Увеличьте "
"для больших заданий со множеством слоёв."

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid "Power scaling"
msgstr "Масштабирование мощности"

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid ""
"When enabled, power_range() raises the emitted minimum as the layer's cut "
"speed decreases (effective-min power scaling); when disabled, the resolved "
"minimum is emitted unchanged."
msgstr ""
"Если включено, power_range() повышает выдаваемый минимум при снижении "
"скорости резки слоя (масштабирование эффективного минимума мощности); если "
"выключено, вычисленный минимум выдаётся без изменений."

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid "Enable VECTOR power floor"
msgstr "Включить нижний порог мощности VECTOR"

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid ""
"When disabled, the emitted power range always has min == max (constant "
"power). When enabled, the VECTOR power floor value below acts as the minimum "
"power for VECTOR cut compensation."
msgstr ""
"Если выключено, выдаваемый диапазон мощности всегда имеет min == max "
"(постоянная мощность). Если включено, значение нижнего порога мощности VECTOR "
"ниже используется как минимальная мощность для компенсации реза VECTOR."

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid "VECTOR power floor"
msgstr "Нижний порог мощности VECTOR"

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid ""
"Minimum power percentage for VECTOR cut compensation (e.g. 8 = 8%). Applies "
"only when the VECTOR power floor toggle is enabled."
msgstr ""
"Минимальный процент мощности для компенсации реза VECTOR (например, 8 = 8%). "
"Применяется только при включённом нижнем пороге мощности VECTOR."

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid "IMAGE power bias"
msgstr "Смещение мощности IMAGE"

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid ""
"Power bias added to IMAGE/raster scan-line power (SET_POWER), % of max (e.g. "
"8 = 8%)."
msgstr ""
"Смещение мощности, добавляемое к мощности растровых строк IMAGE (SET_POWER), "
"% от максимума (например, 8 = 8%)."

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid ""
"set_power is not supported outside of a job with a Ruida controller — the "
"correct handling is to be determined; no command was sent."
msgstr ""
"set_power не поддерживается вне задания с контроллером Ruida — корректная "
"обработка пока не определена; команда не отправлена."

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid ""
"set_focus_power is not supported outside of a job with a Ruida controller — "
"the correct handling is to be determined; no command was sent."
msgstr ""
"set_focus_power не поддерживается вне задания с контроллером Ruida — "
"корректная обработка пока не определена; команда не отправлена."

#: rayforge/machine/driver/ruidarpa/rpa_adapter.py
msgid ""
"set_wcs_offset is not supported: protect mode blocks SET_SETTING, and the "
"feature was dropped by user decision. Use select_wcs to pick a reference "
"point."
msgstr ""
"set_wcs_offset не поддерживается: режим защиты блокирует SET_SETTING, и эта "
"функция была удалена по решению пользователей. Используйте select_wcs для "
"выбора контрольной точки."

