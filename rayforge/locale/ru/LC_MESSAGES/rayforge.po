msgstr "Драйвер не настроен. Проверьте настройки порта."

#: rayforge/machine/driver/grbl/grbl_telnet.py
msgid "GRBL (Telnet)"
msgstr "GRBL (Telnet)"

#: rayforge/machine/driver/grbl/grbl_telnet.py
msgid "GRBL-compatible controller over a raw TCP/telnet connection"
msgstr "Совместимый с GRBL контроллер через прямое TCP/telnet-подключение"

#: rayforge/machine/driver/grbl/grbl_telnet.py
#: rayforge/machine/driver/grbl/grbl_network.py
#: rayforge/machine/driver/smoothie/smoothie_driver.py
msgid "The IP address or hostname of the device"
msgstr "IP-адрес или имя хоста устройства"

#: rayforge/machine/driver/grbl/grbl_telnet.py
msgid "TCP port for the raw/telnet service"
msgstr "TCP-порт службы raw/telnet"

#: rayforge/machine/driver/grbl/grbl_telnet.py
#: rayforge/machine/driver/grbl/grbl_serial.py
msgid "Poll device status during jobs"
msgstr "Опрашивать состояние устройства во время заданий"

#: rayforge/machine/driver/grbl/grbl_telnet.py
#: rayforge/machine/driver/grbl/grbl_serial.py
msgid ""
"Periodically query the device for position and status while a job is "
"running. Warning: Some devices have trouble maintaining a stable connection "
"if this is used!"
msgstr ""
"Периодически запрашивать положение и состояние устройства во время выполнения "
"задания. Внимание: некоторым устройствам это мешает поддерживать стабильное "
"подключение!"

#: rayforge/machine/driver/grbl/grbl_telnet.py
#: rayforge/machine/driver/grbl/grbl_serial.py
msgid "Deadlock detection"
msgstr "Обнаружение взаимоблокировки"

#: rayforge/machine/driver/grbl/grbl_telnet.py
#: rayforge/machine/driver/grbl/grbl_serial.py
msgid ""
"Detect and recover from serial communication deadlocks during jobs. If "
"disabled, the driver will simply wait for the machine to respond. Disable if "
"you experience false ALARM:3 errors."
msgstr ""
"Обнаруживать и восстанавливаться после взаимоблокировек последовательной связи "
"во время заданий. Если выключено, драйвер просто будет ждать ответа станка. "
"Отключите, если появляются ложные ошибки ALARM:3."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Command Letter"
msgstr "Отсутствует буква команды"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"G-code commands need a letter followed by a value. The command letter was "
"not found."
msgstr ""
"Команды G-code должны состоять из буквы и значения. Буква команды не найдена."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Invalid Number Format"
msgstr "Неверный формат числа"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The value is missing or not in the correct numeric format. Check your G-code "
"syntax."
msgstr ""
"Значение отсутствует или имеет неверный числовой формат. Проверьте синтаксис "
"G-code."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unknown Command"
msgstr "Неизвестная команда"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"This Grbl setting command is not recognized or supported. Check the command "
"syntax."
msgstr ""
"Эта команда настройки Grbl не распознана или не поддерживается. Проверьте "
"синтаксис команды."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Negative Value"
msgstr "Отрицательное значение"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "A positive number is required here, but a negative value was received."
msgstr "Здесь требуется положительное число, но получено отрицательное."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Disabled"
msgstr "Возврат в ноль отключён"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Homing is not enabled in settings. Enable homing ($22=1) to use this feature."
msgstr ""
"Возврат в ноль не включён в настройках. Включите его ($22=1), чтобы "
"использовать эту функцию."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Pulse Time Too Short"
msgstr "Слишком короткое время импульса"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Minimum step pulse time must be greater than 3 microseconds. Check setting "
"$0."
msgstr ""
"Минимальное время шагового импульса должно быть больше 3 микросекунд. "
"Проверьте настройку $0."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Memory Error"
msgstr "Ошибка памяти"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Settings reset to defaults due to a memory read failure. Reconfigure your "
"settings if needed."
msgstr ""
"Настройки сброшены к значениям по умолчанию из-за ошибки чтения памяти. При "
"необходимости настройте их заново."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Machine Busy"
msgstr "Станок занят"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"This command can only be used when the machine is idle. Wait for the current "
"job to finish."
msgstr ""
"Эта команда доступна только когда станок простаивает. Дождитесь окончания "
"текущего задания."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Commands Locked"
msgstr "Команды заблокированы"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Cannot send commands while in alarm or jog mode. Clear the alarm state first."
msgstr ""
"Нельзя отправлять команды в состоянии тревоги или ручного перемещения. "
"Сначала сбросьте состояние тревоги."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Required"
msgstr "Требуется возврат в ноль"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Soft limits cannot be enabled without homing also enabled. Enable homing "
"first ($22=1)."
msgstr ""
"Программные ограничения нельзя включить без включённого возврата в ноль. "
"Сначала включите возврат в ноль ($22=1)."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Line Too Long"
msgstr "Слишком длинная строка"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The command line has too many characters and was ignored. Check your file "
"formatting."
msgstr ""
"В строке команды слишком много символов, и она была проигнорирована. "
"Проверьте форматирование файла."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Setting Too High"
msgstr "Значение настройки слишком велико"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"This setting exceeds the maximum step rate supported. Use a lower value."
msgstr ""
"Это значение превышает максимально поддерживаемую частоту шагов. Используйте "
"меньшее значение."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Door Open"
msgstr "Дверца открыта"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The safety door was detected as open. Close the door and resume operation."
msgstr ""
"Обнаружена открытая защитная дверца. Закройте дверцу и продолжите работу."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Build info or startup line exceeds storage limit. Shorten the line."
msgstr ""
"Информация о сборке или стартовая строка превышает лимит хранилища. "
"Сократите строку."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Target Out of Range"
msgstr "Цель вне диапазона"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Jog target is beyond the machine's travel limits. Move to a position within "
"range."
msgstr ""
"Цель ручного перемещения выходит за пределы хода станка. Переместитесь в "
"позицию внутри диапазона."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Invalid Jog Command"
msgstr "Неверная команда ручного перемещения"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Jog command is missing '=' or contains prohibited G-code. Check the jog "
"syntax."
msgstr ""
"В команде ручного перемещения отсутствует «=» или содержится запрещённый "
"G-code. Проверьте синтаксис."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Laser Mode Error"
msgstr "Ошибка режима лазера"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Laser mode requires PWM output to work. Check your hardware configuration."
msgstr ""
"Режим лазера требует выхода PWM. Проверьте конфигурацию оборудования."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Spindle Not Running"
msgstr "Шпиндель не вращается"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"A motion command was issued but the spindle is not running. Start the "
"spindle before motion."
msgstr ""
"Отправлена команда перемещения, но шпиндель не вращается. Запустите шпиндель "
"перед перемещением."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Spindle Speed Mismatch"
msgstr "Несоответствие скорости шпинделя"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The current spindle speed does not match the speed required by the command. "
"Wait for the spindle to reach the target speed."
msgstr ""
"Текущая скорость шпинделя не соответствует требуемой командой. Дождитесь, "
"пока шпиндель выйдет на целевую скорость."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unsupported Command"
msgstr "Неподдерживаемая команда"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"This G-code command is not supported by the machine. Check your post-"
"processor settings."
msgstr ""
"Эта команда G-code не поддерживается станком. Проверьте настройки "
"постпроцессора."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Conflicting Commands"
msgstr "Конфликтующие команды"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Multiple commands from the same group found on one line. Remove the "
"duplicate command."
msgstr ""
"В одной строке найдено несколько команд из одной группы. Удалите дублирующую "
"команду."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Feed Rate Missing"
msgstr "Отсутствует подача"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Set a feed rate before using motion commands. Add an F command to specify "
"speed."
msgstr ""
"Задайте подачу перед использованием команд перемещения. Добавьте команду F "
"для указания скорости."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Integer Required"
msgstr "Требуется целое число"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "This command requires a whole number value. Remove any decimal points."
msgstr ""
"Эта команда требует целочисленного значения. Удалите десятичные разделители."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Axis Conflict"
msgstr "Конфликт осей"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Multiple commands trying to use the same axis. Simplify the command."
msgstr ""
"Несколько команд пытаются использовать одну ось. Упростите команду."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Duplicate Word"
msgstr "Дублирующее слово"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "The same G-code word appears more than once. Remove the duplicate."
msgstr "Одно и то же слово G-code встречается несколько раз. Удалите дубликат."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Axis"
msgstr "Отсутствует ось"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"This command requires XYZ axis coordinates. Add the missing axis values."
msgstr ""
"Эта команда требует координат по осям XYZ. Добавьте недостающие значения "
"осей."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Line Number Out of Range"
msgstr "Номер строки вне диапазона"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Line number must be between 1 and 9,999,999. Use a valid line number."
msgstr ""
"Номер строки должен быть от 1 до 9 999 999. Используйте допустимый номер "
"строки."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Value"
msgstr "Отсутствует значение"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "This command requires a P or L value. Add the missing parameter."
msgstr ""
"Эта команда требует значения P или L. Добавьте недостающий параметр."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unsupported Coordinate"
msgstr "Неподдерживаемая система координат"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Only G54-G59 coordinate systems are supported. Use one of these instead."
msgstr ""
"Поддерживаются только системы координат G54–G59. Используйте одну из них."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Wrong Motion Mode"
msgstr "Неверный режим перемещения"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"G53 command requires G0 or G1 motion mode. Set the correct motion mode first."
msgstr ""
"Команда G53 требует режима перемещения G0 или G1. Сначала установите "
"правильный режим."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unused Axis Words"
msgstr "Неиспользуемые слова осей"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Axis words present but G80 cancel is active. Remove the unused axis words."
msgstr ""
"Присутствуют слова осей, но активна отмена G80. Удалите неиспользуемые слова "
"осей."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Arc Data"
msgstr "Отсутствуют данные дуги"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"G2/G3 arc command needs XYZ coordinates. Add the axis values for the "
"selected plane."
msgstr ""
"Команде дуги G2/G3 нужны координаты XYZ. Добавьте значения осей для выбранной "
"плоскости."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Invalid Target"
msgstr "Недопустимая цель"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Cannot create this arc or probe to current position. Check the target "
"coordinates."
msgstr ""
"Невозможно создать эту дугу или выполнить пробу в текущую позицию. Проверьте "
"целевые координаты."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Arc Geometry Error"
msgstr "Ошибка геометрии дуги"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Arc calculation failed. Try breaking the arc into smaller pieces or use IJK "
"offset instead."
msgstr ""
"Не удалось вычислить дугу. Попробуйте разбить дугу на меньшие части или "
"использовать смещение IJK."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Arc Offset"
msgstr "Отсутствует смещение дуги"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"G2/G3 arc command needs IJK offset values. Add the missing offset for the "
"selected plane."
msgstr ""
"Команде дуги G2/G3 нужны значения смещения IJK. Добавьте недостающее "
"смещение для выбранной плоскости."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unused Words"
msgstr "Неиспользуемые слова"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Some G-code words in this line are not used by any command. Remove the "
"unused words."
msgstr ""
"Некоторые слова G-code в этой строке не используются ни одной командой. "
"Удалите неиспользуемые слова."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Wrong Axis for Offset"
msgstr "Неверная ось для смещения"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Tool length offset only works on the configured axis (usually Z-axis). Check "
"your settings."
msgstr ""
"Смещение длины инструмента работает только на настроенной оси (обычно ось Z). "
"Проверьте настройки."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Tool Number Too High"
msgstr "Слишком большой номер инструмента"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Tool number exceeds the maximum supported value. Use a valid tool number."
msgstr ""
"Номер инструмента превышает максимально поддерживаемое значение. Используйте "
"допустимый номер."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Hard Limit"
msgstr "Аппаратное ограничение"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"A hard limit switch was triggered. The machine has stopped and needs to be "
"reset. Check for obstructions and verify your limit switches."
msgstr ""
"Сработал аппаратный концевой выключатель. Станок остановился и требует "
"сброса. Проверьте отсутствие препятствий и исправность концевиков."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Soft Limit"
msgstr "Программное ограничение"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The machine would move beyond its configured travel limits. Check that your "
"work area and coordinate offsets are correct."
msgstr ""
"Станок собирался выйти за настроенные пределы хода. Проверьте корректность "
"рабочей зоны и смещений координат."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Abort Cycle"
msgstr "Прерывание цикла"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The currently running job was cancelled while in motion. Reset the machine "
"to continue."
msgstr ""
"Текущее задание было отменено во время движения. Для продолжения сбросьте "
"состояние станка."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Probe Fail — Initial"
msgstr "Ошибка пробы — начальная"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The probe did not make contact before the maximum travel distance was "
"reached. Check the probe wiring and positioning."
msgstr ""
"Проба не коснулась цели до достижения максимального расстояния хода. "
"Проверьте подключение и положение пробы."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Probe Fail — Final"
msgstr "Ошибка пробы — конечная"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The probe failed to retract to the target position after contact. Check the "
"probe configuration."
msgstr ""
"Проба не смогла отойти в целевую позицию после контакта. Проверьте "
"конфигурацию пробы."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Fail — Reset"
msgstr "Ошибка возврата в ноль — сброс"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Homing was not able to complete because the machine is in an alarm state. "
"Clear the alarm and try again."
msgstr ""
"Возврат в ноль не удалось завершить, так как станок в состоянии тревоги. "
"Сбросьте тревогу и повторите."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Fail — Approach"
msgstr "Ошибка возврата в ноль — подход"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The homing cycle failed to find the switch within the configured travel "
"distance. Check your switch wiring and pull-off settings."
msgstr ""
"Цикл возврата в ноль не нашёл концевик в пределах настроенного хода. "
"Проверьте подключение концевика и настройки отвода."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Fail — Pulloff"
msgstr "Ошибка возврата в ноль — отвод"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The homing cycle failed to successfully pull off the switch after contact. "
"Increase the pull-off distance or check the switch."
msgstr ""
"Циклу возврата в ноль не удалось отойти от концевика после контакта. "
"Увеличьте расстояние отвода или проверьте концевик."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Home Without Limits"
msgstr "Возврат в ноль без концевиков"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Homing was commanded but limit switches are not configured. Enable limit "
"switches first."
msgstr ""
"Команда возврата в ноль отдана, но концевые выключатели не настроены. Сначала "
"включите концевики."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Fail — Dual Axis"
msgstr "Ошибка возврата в ноль — сдвоенная ось"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"Homing failed on a dual-axis configuration. One or both axes did not reach "
"their limit switches. Check your limit switch wiring and configuration."
msgstr ""
"Ошибка возврата в ноль в конфигурации со сдвоенной осью. Одна или обе оси не "
"дошли до концевиков. Проверьте подключение и настройку концевиков."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unknown Alarm"
msgstr "Неизвестная тревога"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Invalid alarm code reported by machine."
msgstr "Станок сообщил недопустимый код тревоги."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The machine reported an unrecognized alarm code. Check your machine and "
"firmware documentation."
msgstr ""
"Станок сообщил нераспознанный код тревоги. Обратитесь к документации станка и "
"прошивки."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unknown Error"
msgstr "Неизвестная ошибка"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Invalid error code reported by machine."
msgstr "Станок сообщил недопустимый код ошибки."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid ""
"The machine reported an unrecognized error code. Check your machine and "
"firmware documentation."
msgstr ""
"Станок сообщил нераспознанный код ошибки. Обратитесь к документации станка и "
"прошивки."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Stepper Configuration"
msgstr "Конфигурация шаговых двигателей"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Settings related to stepper motor timing and signal polarity."
msgstr "Настройки таймингов шаговых двигателей и полярности сигналов."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Control & Reporting"
msgstr "Управление и отчётность"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Settings for GRBL's motion control and status reporting."
msgstr "Настройки управления движением и отчётов о состоянии GRBL."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Limits & Homing"
msgstr "Ограничения и возврат в ноль"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Settings for soft/hard limits and the homing cycle."
msgstr "Настройки программных/аппаратных ограничений и цикла возврата в ноль."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Spindle & Laser"
msgstr "Шпиндель и лазер"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Settings for controlling the spindle or laser module."
msgstr "Настройки управления шпинделем или лазерным модулем."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Axis Calibration"
msgstr "Калибровка осей"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Defines the steps-per-millimeter for each axis."
msgstr "Задаёт количество шагов на миллиметр для каждой оси."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Axis Kinematics"
msgstr "Кинематика осей"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Defines the maximum rate and acceleration for each axis."
msgstr "Задаёт максимальную скорость и ускорение для каждой оси."

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Axis Travel"
msgstr "Ход осей"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Defines the maximum travel distance for each axis."
msgstr "Задаёт максимальное расстояние хода для каждой оси."

#: rayforge/machine/driver/grbl/grbl_serial.py
msgid "GRBL (Serial)"
msgstr "GRBL (последовательный порт)"

#: rayforge/machine/driver/grbl/grbl_serial.py
msgid "GRBL-compatible serial connection"
msgstr "Последовательное подключение, совместимое с GRBL"

#: rayforge/machine/driver/grbl/grbl_serial.py
msgid "GRBL device"
msgstr "Устройство GRBL"

#: rayforge/machine/driver/grbl/grbl_serial.py
msgid "RX Buffer Size Override"
msgstr "Переопределение размера буфера RX"

#: rayforge/machine/driver/grbl/grbl_serial.py
msgid ""
"Force a specific RX buffer size in bytes. Set to 0 to auto-detect from the "
"device."
msgstr ""
"Принудительно задать размер буфера RX в байтах. Установите 0 для "
"автоопределения устройством."

#: rayforge/machine/driver/grbl/grbl_serial.py
#: rayforge/machine/driver/grbl/grbl_serial_simple.py
#: rayforge/machine/driver/grbl/grbl_network.py
msgid "Unknown Settings"
msgstr "Неизвестные настройки"

#: rayforge/machine/driver/grbl/grbl_serial.py
#: rayforge/machine/driver/grbl/grbl_serial_simple.py
#: rayforge/machine/driver/grbl/grbl_network.py
msgid "Settings reported by the device not in the standard list."
msgstr "Настройки, сообщённые устройством, отсутствуют в стандартном списке."

#: rayforge/machine/driver/grbl/grbl_serial.py
#: rayforge/machine/driver/grbl/grbl_serial_simple.py
#: rayforge/machine/driver/grbl/grbl_network.py
msgid "Unknown setting from device"
msgstr "Неизвестная настройка от устройства"

#: rayforge/machine/driver/grbl/grbl_probe.py
msgid ""
"Device is configured to report in inches ($13=1). All values shown are in "
"machine units."
msgstr ""
"Устройство настроено на отчёт в дюймах ($13=1). Все показанные значения — в "
"единицах станка."

#: rayforge/machine/driver/grbl/grbl_probe.py
msgid ""
"Laser mode is not enabled ($32=0). Enable it for best results with laser "
"cutters."
msgstr ""
"Режим лазера не включён ($32=0). Включите его для лучших результатов с "
"лазерными станками."

#: rayforge/machine/driver/grbl/grbl_serial_simple.py
msgid "GRBL (Serial Simple)"
msgstr "GRBL (простой последовательный порт)"

#: rayforge/machine/driver/grbl/grbl_serial_simple.py
msgid "GRBL serial with simple ping-pong protocol (no buffer counting)"
msgstr ""
"Последовательное подключение GRBL с простым протоколом ping-pong (без "
"подсчёта буфера)"

#: rayforge/machine/driver/grbl/grbl_serial_simple.py
msgid "Baudrate must be configured."
msgstr "Необходимо настроить скорость соединения."

#: rayforge/machine/driver/grbl/grbl_network.py
msgid "GRBL (Network)"
msgstr "GRBL (сеть)"

#: rayforge/machine/driver/grbl/grbl_network.py
msgid "Connect to a GRBL-compatible device over the network"
msgstr "Подключение к совместимому с GRBL устройству по сети"

#: rayforge/machine/driver/grbl/grbl_network.py
msgid "HTTP Port"
msgstr "HTTP-порт"

#: rayforge/machine/driver/grbl/grbl_network.py
msgid "The HTTP port for the device"
msgstr "HTTP-порт устройства"

#: rayforge/machine/driver/grbl/grbl_network.py
msgid "WebSocket Port"
msgstr "Порт WebSocket"

#: rayforge/machine/driver/grbl/grbl_network.py
msgid ""
"The WebSocket port for the device. For FluidNC, use the same port as HTTP "
"(usually 80)."
msgstr ""
"Порт WebSocket устройства. Для FluidNC используйте тот же порт, что и для "
"HTTP (обычно 80)."

#: rayforge/machine/driver/grbl/grbl_network.py
msgid "Protocol variant"
msgstr "Вариант протокола"

#: rayforge/machine/driver/grbl/grbl_network.py
msgid "Standard, ESP3D, Longer, or FluidNC variant"
msgstr "Вариант: Standard, ESP3D, Longer или FluidNC"

#: rayforge/machine/driver/grbl/grbl_network.py
msgid "Standard"
msgstr "Standard"

#: rayforge/machine/driver/grbl/grbl_network.py
msgid "Host is not configured. Please set a valid IP address or hostname."
msgstr ""
"Хост не настроен. Укажите допустимый IP-адрес или имя хоста."

#: rayforge/machine/driver/grbl/grbl_network.py
#, python-brace-format
msgid ""
"Could not connect to host '{host}'. Check the IP address and network "
"connection."
msgstr ""
"Не удалось подключиться к хосту «{host}». Проверьте IP-адрес и сетевое "
"подключение."

#: rayforge/machine/driver/smoothie/smoothie_util.py
#, python-brace-format
msgid ""
"Smoothie reported a non-positive work-area dimension (alpha_max={x}, "
"beta_max={y})."
msgstr ""
"Smoothie сообщил о неположительном размере рабочей зоны (alpha_max={x}, "
"beta_max={y})."

#: rayforge/machine/driver/smoothie/smoothie_util.py
msgid "Could not read the Smoothie work-area dimensions."
msgstr "Не удалось прочитать размеры рабочей зоны Smoothie."

#: rayforge/machine/driver/smoothie/smoothie_util.py
msgid "Could not read the Smoothie maximum feed rates."
msgstr "Не удалось прочитать максимальные подачи Smoothie."

#: rayforge/machine/driver/smoothie/smoothie_util.py
msgid "Could not read the Smoothie acceleration."
msgstr "Не удалось прочитать ускорение Smoothie."

#: rayforge/machine/driver/smoothie/smoothie_driver.py
msgid "Smoothie"
msgstr "Smoothie"

#: rayforge/machine/driver/smoothie/smoothie_driver.py
msgid "Smoothieware via a Telnet connection"
msgstr "Smoothieware через Telnet-подключение"

#: rayforge/machine/driver/smoothie/smoothie_driver.py
msgid "Driver is not set up. Check the connection settings."
msgstr "Драйвер не настроен. Проверьте настройки подключения."

#: rayforge/machine/driver/smoothie/smoothie_driver.py
msgid "The Telnet port number"
msgstr "Номер порта Telnet"

#: rayforge/machine/driver/smoothie/smoothie_driver.py
msgid "Host not configured"
msgstr "Хост не настроен"

