#: laser_essentials/steps/material_test.py
msgid "Minimum Power (%)"
msgstr "Minimale Leistung (%)"

#: laser_essentials/steps/material_test.py
msgid "Maximum Power (%)"
msgstr "Maximale Leistung (%)"

#: laser_essentials/steps/material_test.py
msgid "For first column"
msgstr "Für die erste Spalte"

#: laser_essentials/steps/material_test.py
msgid "For last column"
msgstr "Für die letzte Spalte"

#: laser_essentials/steps/material_test.py
msgid "Speed Range"
msgstr "Geschwindigkeitsbereich"

#: laser_essentials/steps/material_test.py
msgid "Minimum Speed"
msgstr "Minimale Geschwindigkeit"

#: laser_essentials/steps/material_test.py
msgid "Maximum Speed"
msgstr "Maximale Geschwindigkeit"

#: laser_essentials/steps/material_test.py
msgid "Starting speed"
msgstr "Startgeschwindigkeit"

#: laser_essentials/steps/material_test.py
msgid "Ending speed"
