#: dragknife/widgets/pages.py dragknife/steps/knife_cut_step.py
msgid "Step Settings"
msgstr "Paramètres de l'étape"

#: dragknife/widgets/pages.py
msgid "Drag Knife"
msgstr "Lame traînante"

#: dragknife/widgets/pages.py
msgid "Cut the workpiece outline with a drag knife."
msgstr "Découpe le contour de la pièce avec une lame traînante."

#: dragknife/widgets/pages.py
#: dragknife/transformers/tangential_knife_transformer.py
msgid "Tangential Knife"
msgstr "Lame tangentielle"

#: dragknife/widgets/pages.py
msgid ""
"Cut the workpiece outline with a rotary knife that stays tangent to the path."
msgstr ""
"Découpe le contour de la pièce avec une lame rotative qui reste tangente au "
"parcours."

#: dragknife/transformers/drag_knife_transformer.py
msgid "Drag Knife Compensation"
msgstr "Compensation de lame traînante"

#: dragknife/transformers/drag_knife_transformer.py
msgid ""
"Compensates contours for the blade offset of a drag knife and pivots the "
"blade around corners."
msgstr ""
"Compense les contours selon le décalage de la lame d'une lame traînante et "
"fait pivoter la lame dans les angles."

#: dragknife/transformers/tangential_knife_transformer.py
msgid ""
"Rotates a tangential knife to stay tangent to the path and lifts it at sharp "
"corners."
msgstr ""
"Fait tourner une lame tangentielle pour la maintenir tangente au parcours et "
"la relève dans les angles vifs."

#: dragknife/steps/tangential_knife_cut_step.py
msgid "Tangential Knife Cut"
msgstr "Découpe à la lame tangentielle"

#: dragknife/steps/tangential_knife_cut_step.py
msgid "Angle Tolerance"
msgstr "Tolérance d'angle"

#: dragknife/steps/tangential_knife_cut_step.py
msgid ""
"Maximum heading change rotated with the knife down; larger changes lift the "
"knife"
msgstr ""
"Changement de cap maximal pivoté avec la lame baissée ; les changements plus "
"importants relèvent la lame"

#: dragknife/steps/tangential_knife_cut_step.py
msgid "Radius Tolerance"
msgstr "Tolérance de rayon"

#: dragknife/steps/tangential_knife_cut_step.py
msgid "Arcs tighter than this radius are cut with the knife lifted"
msgstr "Les arcs plus serrés que ce rayon sont découpés avec la lame relevée"

#: dragknife/steps/tangential_knife_cut_step.py
msgid "Spindle RPM"
msgstr "Vitesse de broche"

#: dragknife/steps/tangential_knife_cut_step.py
msgid "Blade motor speed (M3)"
msgstr "Vitesse du moteur de la lame (M3)"

#: dragknife/steps/knife_cut_step.py
msgid ""
"Knife head used for this step; the machine's first knife is used when unset"
msgstr ""
"Tête de lame utilisée pour cette étape ; si elle n'est pas définie, la "
"première lame de la machine est utilisée"

#: dragknife/steps/knife_cut_step.py
msgid "Blade Offset"
msgstr "Décalage de la lame"

#: dragknife/steps/knife_cut_step.py
msgid "Distance between the blade tip and the machine's pivot point"
msgstr "Distance entre la pointe de la lame et le point de pivot de la machine"

#: dragknife/steps/knife_cut_step.py
msgid "Safe Z Height"
msgstr "Hauteur Z de sécurité"

#: dragknife/steps/knife_cut_step.py
msgid "Height to retract between moves"
msgstr "Hauteur de retrait entre les mouvements"

#: dragknife/steps/knife_cut_step.py
msgid "Knife head, blade geometry, and retraction height for this operation."
msgstr ""
"Tête de lame, géométrie de la lame et hauteur de retrait pour cette "
"opération."

#: dragknife/steps/knife_cut_step.py dragknife/knife_head_var.py
msgid "Knife"
msgstr "Lame"

#: dragknife/steps/drag_knife_cut_step.py
msgid "Drag Knife Cut"
msgstr "Découpe à la lame traînante"

#: dragknife/steps/drag_knife_cut_step.py
msgid "Swivel Angle"
msgstr "Angle de pivotement"

#: dragknife/steps/drag_knife_cut_step.py
msgid ""
"Maximum corner angle pivoted with the blade down; sharper corners lift the "
"knife first"
msgstr ""
"Angle d'angle maximal pivoté avec la lame baissée ; les angles plus vifs "
"relèvent d'abord la lame"
