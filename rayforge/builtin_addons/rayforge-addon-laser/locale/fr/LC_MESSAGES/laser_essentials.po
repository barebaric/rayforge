msgid "Air Assist"
msgstr "Assistance d'air"

#: laser_essentials/steps/laser_step.py
msgid "Blow air over the cut to clear debris"
msgstr "Souffler de l'air sur la coupe pour évacuer les débris"

#: laser_essentials/steps/laser_step.py
msgid "Tab Power"
msgstr "Puissance des languettes"

#: laser_essentials/steps/laser_step.py
msgid "Laser power at tab positions as a percentage"
msgstr "Puissance laser aux positions des languettes en pourcentage"

#: laser_essentials/steps/laser_step.py
msgid "Frequency"
msgstr "Fréquence"

#: laser_essentials/steps/laser_step.py
msgid "Laser pulse frequency in Hz (0 = head default)"
msgstr "Fréquence des impulsions laser en Hz (0 = défaut de la tête)"

#: laser_essentials/steps/laser_step.py
msgid "Pulse Width"
msgstr "Largeur d'impulsion"

#: laser_essentials/steps/laser_step.py
msgid "Laser pulse width in ns (0 = head default)"
msgstr "Largeur des impulsions laser en ns (0 = défaut de la tête)"

