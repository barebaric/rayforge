#: laser_essentials/steps/laser_step.py
msgid ""
"Laser head used for this step; the machine's first head is used when unset"
msgstr ""
"Für diesen Schritt verwendeter Laserkopf; falls nicht gesetzt, wird der "
"erste Kopf der Maschine verwendet"

#: laser_essentials/steps/laser_step.py
msgid "Laser power as a percentage"
msgstr "Laserleistung als Prozentsatz"

#: laser_essentials/steps/laser_step.py
msgid "Air Assist"
msgstr "Luftunterstützung"

#: laser_essentials/steps/laser_step.py
msgid "Blow air over the cut to clear debris"
msgstr "Bläst Luft über den Schnitt, um Rückstände zu entfernen"

#: laser_essentials/steps/laser_step.py
msgid "Tab Power"
msgstr "Haltesteg-Leistung"

#: laser_essentials/steps/laser_step.py
msgid "Laser power at tab positions as a percentage"
msgstr "Laserleistung an den Haltesteg-Positionen als Prozentsatz"

#: laser_essentials/steps/laser_step.py
msgid "Frequency"
msgstr "Frequenz"

#: laser_essentials/steps/laser_step.py
msgid "Laser pulse frequency in Hz (0 = head default)"
msgstr "Laserpulsfrequenz in Hz (0 = Kopfstandardwert)"

#: laser_essentials/steps/laser_step.py
msgid "Pulse Width"
msgstr "Pulsbreite"

#: laser_essentials/steps/laser_step.py
msgid "Laser pulse width in ns (0 = head default)"
msgstr "Laserpulsbreite in ns (0 = Kopfstandardwert)"

#: laser_essentials/steps/laser_step.py
msgid "Step Settings"
msgstr "Schritt-Einstellungen"

#: laser_essentials/steps/laser_step.py
#, python-brace-format
msgid "{power_percent}% power, {speed_str}"
msgstr "{power_percent}% Leistung, {speed_str}"

#: laser_essentials/steps/shrinkwrap_step.py
msgid "Gravity"
msgstr "Anziehung"

#: laser_essentials/steps/shrinkwrap_step.py
msgid "Pulls the hull inward. 0.0 is a standard convex hull"
msgstr "Zieht die Hülle nach innen. 0.0 ist eine standardmäßige konvexe Hülle"

#: laser_essentials/steps/shrinkwrap_step.py
#: laser_essentials/steps/frame_step.py laser_essentials/steps/contour_step.py
msgid "Cut Side"
msgstr "Schnittseite"

#: laser_essentials/steps/shrinkwrap_step.py
#: laser_essentials/steps/wavefront_step.py
#: laser_essentials/steps/frame_step.py laser_essentials/steps/contour_step.py
msgid "Offset"
msgstr "Versatz"

#: laser_essentials/steps/shrinkwrap_step.py
msgid ""
"Shifts the contour inward/outward per Cut Side (none on Centerline). "
"Defaults to kerf compensation for the head"
msgstr ""
"Verschiebt die Kontur je nach Schnittseite nach innen/außen (keine bei "
"Mittellinie). Standardmäßig Kerf-Kompensation für den Kopf"

#: laser_essentials/steps/wavefront_step.py
msgid "Step Over"
msgstr "Schrittweite"

#: laser_essentials/steps/wavefront_step.py
msgid "Lateral step-over between wavefront passes"
msgstr "Seitliche Zustellung zwischen den Wellenfrontdurchgängen"

#: laser_essentials/steps/wavefront_step.py
msgid "Extra offset from walls"
msgstr "Zusätzlicher Versatz von Wänden"

#: laser_essentials/steps/frame_step.py
msgid "Frame"
msgstr "Rahmen"

#: laser_essentials/steps/frame_step.py
msgid ""
"Shifts the frame inward/outward per Cut Side (none on Centerline). Defaults "
"to kerf compensation for the head"
msgstr ""
"Verschiebt den Rahmen je nach Schnittseite nach innen/außen (keine bei "
"Mittellinie). Standardmäßig Kerf-Kompensation für den Kopf"

#: laser_essentials/steps/raster_step.py
msgid "Mode"
msgstr "Modus"

#: laser_essentials/steps/raster_step.py laser_essentials/steps/contour_step.py
msgid "Threshold"
msgstr "Schwellenwert"

#: laser_essentials/steps/raster_step.py
msgid "Brightness cutoff for black/white (0-255)"
msgstr "Helligkeitsgrenzwert für Schwarz/Weiß (0-255)"

#: laser_essentials/steps/raster_step.py
msgid "Engraving Method"
msgstr "Gravurmethode"

#: laser_essentials/steps/raster_step.py
msgid "Algorithm for converting grayscale to binary"
msgstr "Algorithmus zum Konvertieren von Graustufen in Binär"

#: laser_essentials/steps/raster_step.py
msgid "Cross-Hatch"
msgstr "Kreuzschraffur"

#: laser_essentials/steps/raster_step.py
msgid "Add a second pass at 90 degrees"
msgstr "Einen zweiten Durchgang bei 90 Grad hinzufügen"

#: laser_essentials/steps/raster_step.py
msgid "Scan Mode"
msgstr "Scan-Modus"

#: laser_essentials/steps/raster_step.py
msgid "Segmented"
msgstr "Segmentiert"

#: laser_essentials/steps/raster_step.py
msgid "Full Sweep"
msgstr "Vollflächig"

#: laser_essentials/steps/raster_step.py
msgid ""
"Segmented: moves between content regions. Full Sweep: scans full width with "
"laser toggling"
msgstr ""
"Segmentiert: Bewegt sich zwischen Inhaltsbereichen. Vollflächig: Scannt die "
"volle Breite bei aktiviertem/deaktiviertem Laser"

#: laser_essentials/steps/raster_step.py
msgid "Line Spacing"
msgstr "Linienabstand"

#: laser_essentials/steps/raster_step.py
msgid "Distance between scan lines"
msgstr "Abstand zwischen Scanzeilen"

#: laser_essentials/steps/raster_step.py
msgid "Sample Interval"
msgstr "Abtastintervall"

#: laser_essentials/steps/raster_step.py
msgid ""
"Distance between power samples along scan line. Lower values improve "
"accuracy, but increase output size"
msgstr ""
"Abstand zwischen Leistungsabtastungen entlang der Scanlinie. Kleinere Werte "
"verbessern die Genauigkeit, erhöhen aber die Ausgabegröße"

#: laser_essentials/steps/raster_step.py
msgid "Dot Width Correction"
msgstr "Punktbreitenkorrektur"

#: laser_essentials/steps/raster_step.py
msgid ""
"Reduces engrave length at both ends to compensate for physical dot width"
msgstr ""
"Verkürzt die Gravurlänge an beiden Enden, um die physikalische Punktbreite "
"auszugleichen"

#: laser_essentials/steps/raster_step.py
msgid "Bidirectional Scan Offset"
msgstr "Bidirektionaler Scan-Versatz"

#: laser_essentials/steps/raster_step.py
msgid ""
"Corrects X misalignment between left-to-right and right-to-left raster passes"
msgstr ""
"Korrigiert die X-Ausrichtung zwischen Rasterdurchgängen von links nachrechts "
"und von rechts nach links"

#: laser_essentials/steps/raster_step.py
msgid "Invert"
msgstr "Invertieren"

#: laser_essentials/steps/raster_step.py
msgid "Engrave white areas instead of black areas"
msgstr "Weiße Bereiche anstelle von schwarzen Bereichen gravieren"

#: laser_essentials/steps/raster_step.py
msgid "Number of Depth Levels"
msgstr "Anzahl der Tiefenstufen"

#: laser_essentials/steps/raster_step.py
msgid "Z Step-Down per Level"
msgstr "Z-Absenkung pro Ebene"

#: laser_essentials/steps/raster_step.py
msgid "Rotate Angle Per Pass"
msgstr "Rotationswinkel pro Durchgang"

#: laser_essentials/steps/raster_step.py
msgid "Degrees to rotate each successive pass"
msgstr "Grad, um die jeder folgende Durchgang rotiert wird"

#: laser_essentials/steps/raster_step.py
msgid "Auto Levels"
msgstr "Automatische Pegel"

#: laser_essentials/steps/raster_step.py
msgid "Automatically adjust black/white points"
msgstr "Schwarz/Weiß-Punkte automatisch anpassen"

#: laser_essentials/steps/raster_step.py
msgid "White Point"
msgstr "Weißpunkt"

#: laser_essentials/steps/raster_step.py
msgid "Min Power"
msgstr "Min. Leistung"

#: laser_essentials/steps/raster_step.py
msgid "Max Power"
msgstr "Max. Leistung"

#: laser_essentials/steps/raster_step.py
msgid "Power Levels"
msgstr "Leistungsstufen"

#: laser_essentials/steps/raster_step.py
msgid "Number of discrete power steps (lower = fewer moves)"
msgstr "Anzahl der diskreten Leistungsstufen (weniger = weniger Bewegungen)"

#: laser_essentials/steps/contour_step.py
msgid "Contour"
msgstr "Kontur"

#: laser_essentials/steps/contour_step.py
msgid ""
"Shifts the cut path inward/outward per Cut Side (none on Centerline). "
"Defaults to kerf compensation for the head"
msgstr ""
"Verschiebt den Schnittpfad je nach Schnittseite nach innen/außen (keine bei "
"Mittellinie). Standardmäßig Kerf-Kompensation für den Kopf"

#: laser_essentials/steps/contour_step.py
msgid "Cut Order"
msgstr "Schnittreihenfolge"

#: laser_essentials/steps/contour_step.py
msgid "Processing order for nested paths"
msgstr "Verarbeitungsreihenfolge für verschachtelte Pfade"

#: laser_essentials/steps/contour_step.py
msgid "Remove Inner Paths"
msgstr "Innere Pfade entfernen"

#: laser_essentials/steps/contour_step.py
msgid "If enabled, only trace the outer outline of shapes"
msgstr "Wenn aktiviert, wird nur die äußere Kontur von Formen nachgezeichnet."

#: laser_essentials/steps/contour_step.py
msgid "Overcut"
msgstr "Überschnitt"

#: laser_essentials/steps/contour_step.py
msgid ""
"Extend closed contours past their start point so the cut overlaps itself"
msgstr ""
"Geschlossene Konturen über den Startpunkt hinaus verlängern, sodass sich der "
"Schnitt überlappt"

#: laser_essentials/steps/contour_step.py
msgid "Brightness level (0.0-1.0) to define edges"
msgstr "Helligkeitsstufe (0.0-1.0) zur Definition von Kanten"

#: laser_essentials/steps/contour_step.py
msgid "Rescan Content"
msgstr "Inhalt neu scannen"

#: laser_essentials/steps/contour_step.py
msgid "Ignore source geometry and re-trace within the workpiece"
msgstr ""
"Quellgeometrie ignorieren und innerhalb des Werkstücks neu nachzeichnen"

