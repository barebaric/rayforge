msgstr "Angle de rotation par passe"

#: laser_essentials/steps/raster_step.py
msgid "Degrees to rotate each successive pass"
msgstr "Degrés de rotation pour chaque passe successive"

#: laser_essentials/steps/raster_step.py
msgid "Auto Levels"
msgstr "Niveaux Automatiques"

#: laser_essentials/steps/raster_step.py
msgid "Automatically adjust black/white points"
msgstr "Ajuster automatiquement les points noir/blanc"

#: laser_essentials/steps/raster_step.py
msgid "White Point"
msgstr "Point blanc"

#: laser_essentials/steps/raster_step.py
msgid "Min Power"
msgstr "Puissance minimale"

#: laser_essentials/steps/raster_step.py
msgid "Max Power"
msgstr "Puissance max."

#: laser_essentials/steps/raster_step.py
msgid "Power Levels"
msgstr "Niveaux de puissance"

#: laser_essentials/steps/raster_step.py
msgid "Number of discrete power steps (lower = fewer moves)"
msgstr "Nombre de pas de puissance discrets (plus bas = moins de déplacements)"

#: laser_essentials/steps/raster_step.py
#, python-brace-format
msgid "The {mode} depth mode is not supported by this machine's driver."
msgstr ""
"Le mode de profondeur {mode} n'est pas pris en charge par le pilote de cette "
"machine."

#: laser_essentials/steps/contour_step.py
msgid "Contour"
msgstr "Contour"

#: laser_essentials/steps/contour_step.py
msgid ""
"Shifts the cut path inward/outward per Cut Side (none on Centerline). "
"Defaults to kerf compensation for the head"
msgstr ""
"Décale le trajet de coupe vers l'intérieur/extérieur selon le côté de coupe "
"(aucun sur la ligne centrale). Par défaut, compense le kerf de la tête"

