msgstr "Размер рабочей зоны (X × Y)"

#: rayforge/machine/device/profile.py
msgid "Work Margins"
msgstr "Поля рабочей зоны"

#: rayforge/machine/device/profile.py rayforge/ui_gtk/machine/hardware_page.py
#: rayforge/ui_gtk/machine/wizard_pages/hardware_page.py
msgid "Soft Limits"
msgstr "Программные ограничения"

#: rayforge/machine/device/profile.py rayforge/ui_gtk/machine/hardware_page.py
#: rayforge/ui_gtk/machine/wizard_pages/hardware_page.py
msgid "Enable Soft Limits"
msgstr "Включить программные ограничения"

#: rayforge/machine/device/profile.py
msgid "Coordinate Origin"
msgstr "Начало координат"

#: rayforge/machine/device/profile.py rayforge/ui_gtk/machine/hardware_page.py
#: rayforge/ui_gtk/machine/wizard_pages/review_page.py
#: rayforge/ui_gtk/machine/wizard_pages/hardware_page.py
msgid "Panel Orientation"
msgstr "Ориентация панели"

#: rayforge/machine/device/profile.py rayforge/ui_gtk/machine/hardware_page.py
#: rayforge/ui_gtk/machine/wizard_pages/hardware_page.py
msgid "Has Z-Axis"
msgstr "Есть ось Z"

#: rayforge/machine/device/profile.py rayforge/ui_gtk/machine/hardware_page.py
#: rayforge/ui_gtk/machine/wizard_pages/hardware_page.py
msgid "Reverse X-Axis Direction"
msgstr "Инвертировать направление оси X"

#: rayforge/machine/device/profile.py rayforge/ui_gtk/machine/hardware_page.py
#: rayforge/ui_gtk/machine/wizard_pages/hardware_page.py
msgid "Reverse Y-Axis Direction"
msgstr "Инвертировать направление оси Y"

#: rayforge/machine/device/profile.py rayforge/ui_gtk/machine/hardware_page.py
