msgstr "Materialtestgitter"

#: laser_essentials/steps/material_test.py
msgid "Test Type"
msgstr "Testtyp"

#: laser_essentials/steps/material_test.py
msgid "Cut: outlines; Engrave: fills with raster lines"
msgstr "Schnitt: Umrisse; Gravieren: Füllt mit Rasterlinien"

#: laser_essentials/steps/material_test.py
msgid "Grid Mode"
