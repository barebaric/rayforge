msgstr "चयनित सामग्री के चारों ओर फ़्रेम काटें."

#: laser_essentials/widgets/material_test_grid_page.py
msgid "Columns (Power Steps)"
msgstr "कॉलम (शक्ति चरण)"

#: laser_essentials/widgets/material_test_grid_page.py
