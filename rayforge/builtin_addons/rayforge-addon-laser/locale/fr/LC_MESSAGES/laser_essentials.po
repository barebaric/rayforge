msgid "Scan Mode"
msgstr "Mode de balayage"

#: laser_essentials/steps/raster_step.py
msgid "Segmented"
msgstr "Segmenté"

#: laser_essentials/steps/raster_step.py
msgid "Full Sweep"
msgstr "Balayage complet"

#: laser_essentials/steps/raster_step.py
msgid ""
"Segmented: moves between content regions. Full Sweep: scans full width with "
"laser toggling"
msgstr ""
"Segmenté : se déplace entre les zones de contenu. Balayage complet : scanne "
"toute la largeur en activant/désactivant le laser"

