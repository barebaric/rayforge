#: dragknife/widgets/pages.py dragknife/steps/knife_cut_step.py
msgid "Step Settings"
msgstr "Налаштування кроку"

#: dragknife/widgets/pages.py
msgid "Drag Knife"
msgstr "Драг-ніж"

#: dragknife/widgets/pages.py
msgid "Cut the workpiece outline with a drag knife."
msgstr "Ріже контур заготовки драг-ножем."

#: dragknife/widgets/pages.py
#: dragknife/transformers/tangential_knife_transformer.py
msgid "Tangential Knife"
msgstr "Тангенціальний ніж"

#: dragknife/widgets/pages.py
msgid ""
"Cut the workpiece outline with a rotary knife that stays tangent to the path."
msgstr ""
"Ріже контур заготовки ротаційним ножем, що залишається дотичним до шляху."

#: dragknife/transformers/drag_knife_transformer.py
msgid "Drag Knife Compensation"
msgstr "Компенсація драг-ножа"

#: dragknife/transformers/drag_knife_transformer.py
msgid ""
"Compensates contours for the blade offset of a drag knife and pivots the "
"blade around corners."
msgstr ""
"Компенсує контури на зміщення леза драг-ножа та повертає лезо на кутах."

#: dragknife/transformers/tangential_knife_transformer.py
msgid ""
"Rotates a tangential knife to stay tangent to the path and lifts it at sharp "
"corners."
msgstr ""
"Повертає тангенціальний ніж, щоб він залишався дотичним до шляху, і піднімає "
"його на гострих кутах."

#: dragknife/steps/tangential_knife_cut_step.py
msgid "Tangential Knife Cut"
msgstr "Різання тангенціальним ножем"

#: dragknife/steps/tangential_knife_cut_step.py
msgid "Angle Tolerance"
msgstr "Допуск кута"

#: dragknife/steps/tangential_knife_cut_step.py
msgid ""
"Maximum heading change rotated with the knife down; larger changes lift the "
"knife"
msgstr ""
"Максимальна зміна напрямку, яку повертають з опущеним ножем; більші зміни "
"піднімають ніж"

#: dragknife/steps/tangential_knife_cut_step.py
msgid "Radius Tolerance"
msgstr "Допуск радіуса"

#: dragknife/steps/tangential_knife_cut_step.py
msgid "Arcs tighter than this radius are cut with the knife lifted"
msgstr "Дуги, тісніші за цей радіус, ріжуть з піднятим ножем"

#: dragknife/steps/tangential_knife_cut_step.py
msgid "Spindle RPM"
msgstr "Оберти шпинделя"

#: dragknife/steps/tangential_knife_cut_step.py
msgid "Blade motor speed (M3)"
msgstr "Швидкість двигуна леза (M3)"

#: dragknife/steps/knife_cut_step.py
msgid ""
"Knife head used for this step; the machine's first knife is used when unset"
msgstr ""
"Головка ножа для цього кроку; якщо не задано, використовується перший ніж "
"машини"

#: dragknife/steps/knife_cut_step.py
msgid "Blade Offset"
msgstr "Зміщення леза"

#: dragknife/steps/knife_cut_step.py
msgid "Distance between the blade tip and the machine's pivot point"
msgstr "Відстань між кінчиком леза та точкою повороту машини"

#: dragknife/steps/knife_cut_step.py
msgid "Safe Z Height"
msgstr "Безпечна висота Z"

#: dragknife/steps/knife_cut_step.py
msgid "Height to retract between moves"
msgstr "Висота відведення між переміщеннями"

#: dragknife/steps/knife_cut_step.py
msgid "Knife head, blade geometry, and retraction height for this operation."
msgstr "Головка ножа, геометрія леза та висота відведення для цієї операції."

#: dragknife/steps/knife_cut_step.py dragknife/knife_head_var.py
msgid "Knife"
msgstr "Ніж"

#: dragknife/steps/drag_knife_cut_step.py
msgid "Drag Knife Cut"
msgstr "Різання драг-ножем"

#: dragknife/steps/drag_knife_cut_step.py
msgid "Swivel Angle"
msgstr "Кут повороту"

#: dragknife/steps/drag_knife_cut_step.py
msgid ""
"Maximum corner angle pivoted with the blade down; sharper corners lift the "
"knife first"
msgstr ""
"Максимальний кут, який повертають з опущеним лезом; гостріші кути спершу "
"піднімають ніж"
