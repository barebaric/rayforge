msgid "Cut Order"
msgstr "Ordre de coupe"

#: laser_essentials/steps/contour_step.py
msgid "Processing order for nested paths"
msgstr "Ordre de traitement des chemins imbriqués"

#: laser_essentials/steps/contour_step.py
msgid "Remove Inner Paths"
msgstr "Supprimer les chemins intérieurs"

#: laser_essentials/steps/contour_step.py
msgid "If enabled, only trace the outer outline of shapes"
msgstr "Si activé, ne tracer que le contour extérieur des formes"

#: laser_essentials/steps/contour_step.py
msgid "Overcut"
msgstr "Surcoupe"

